<?xml version="1.0" encoding="UTF-8" ?>
<ContentView
    x:Class="TravelAgency.App.Controls.TripImageCarousel"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TravelAgency.App.Controls"
    x:Name="Root">

    <Grid IsClippedToBounds="True">
        <CarouselView
            x:Name="Carousel"
            IndicatorView="Indicators"
            Loop="False"
            PositionChanged="OnPositionChanged">
            <CarouselView.ItemTemplate>
                <DataTemplate>
                    <controls:NetworkImage Aspect="AspectFill" Source="{Binding Source}">
                        <controls:NetworkImage.GestureRecognizers>
                            <TapGestureRecognizer
                                CommandParameter="{Binding .}"
                                Tapped="OnImageTapped" />
                        </controls:NetworkImage.GestureRecognizers>
                    </controls:NetworkImage>
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <Border
            x:Name="IndicatorsHost"
            Margin="0,0,12,10"
            Padding="8,4"
            BackgroundColor="#66000000"
            HorizontalOptions="End"
            InputTransparent="True"
            StrokeShape="RoundRectangle 100"
            StrokeThickness="0"
            VerticalOptions="End">
            <IndicatorView
                x:Name="Indicators"
                IndicatorColor="#B3FFFFFF"
                IndicatorSize="7"
                SelectedIndicatorColor="#FFFFFF" />
        </Border>

        <Label
            x:Name="CounterLabel"
            Margin="{Binding CounterMargin, Source={x:Reference Root}}"
            Padding="8,3"
            BackgroundColor="#99000000"
            FontAttributes="Bold"
            FontSize="12"
            HorizontalOptions="End"
            InputTransparent="True"
            IsVisible="False"
            TextColor="#FFFFFF"
            VerticalOptions="Start" />
    </Grid>
</ContentView>
