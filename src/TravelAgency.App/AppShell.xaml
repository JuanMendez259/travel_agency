<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="TravelAgency.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:client="clr-namespace:TravelAgency.App.Modules.Client.Views"
    xmlns:admin="clr-namespace:TravelAgency.App.Modules.Admin.Views"
    Shell.BackgroundColor="#FAF8FF"
    Shell.ForegroundColor="#003B1B"
    Shell.TitleColor="#003B1B"
    Shell.DisabledColor="#B9C2C0"
    Shell.UnselectedColor="#717970"
    Shell.TabBarBackgroundColor="#FFFFFF"
    Shell.TabBarForegroundColor="#003B1B"
    Shell.TabBarTitleColor="#003B1B"
    Shell.TabBarUnselectedColor="#717970"
    Shell.TabBarDisabledColor="#B9C2C0"
    Title="TravelAgency">

    <TabBar>
        <ShellContent
            Title="Explorar"
            Icon="nav_compass.svg"
            ContentTemplate="{DataTemplate client:ClientHomePage}"
            Route="home" />
        <ShellContent
            Title="Mis Viajes"
            Icon="nav_tickets.svg"
            ContentTemplate="{DataTemplate client:ClientMyTripsPage}"
            Route="mytrips" />
        <ShellContent
            Title="Mi Perfil"
            Icon="nav_circle_user.svg"
            ContentTemplate="{DataTemplate client:ClientProfilePage}"
            Route="profile" />
        <ShellContent
            Title="Nosotros"
            Icon="nav_info.svg"
            ContentTemplate="{DataTemplate client:ClientCompanyPage}"
            Route="company" />
        <ShellContent
            Title="Mis Viajes"
            Icon="nav_tickets.svg"
            ContentTemplate="{DataTemplate admin:AdminTripsPage}"
            Route="admintrips" />
        <ShellContent
            Title="Reservas"
            Icon="nav_calendar_check.svg"
            ContentTemplate="{DataTemplate admin:AdminBookingsPage}"
            Route="bookings" />
        <ShellContent
            Title="Estadísticas"
            Icon="nav_chart_column.svg"
            ContentTemplate="{DataTemplate admin:AdminStatsPage}"
            Route="adminstats" />
        <ShellContent
            Title="Admin"
            Icon="nav_layout_dashboard.svg"
            ContentTemplate="{DataTemplate admin:AdminDashboardPage}"
            Route="admin" />
        <ShellContent
            Title="Coordinadores"
            Icon="nav_user_cog.svg"
            ContentTemplate="{DataTemplate admin:AdminCoordinadoresPage}"
            Route="coordinators" />
        <ShellContent
            Title="Descuentos"
            Icon="nav_ticket_percent.svg"
            ContentTemplate="{DataTemplate admin:AdminDiscountsPage}"
            Route="discounts" />
        <ShellContent
            Title="Reembolsos"
            Icon="nav_hand_coins.svg"
            ContentTemplate="{DataTemplate admin:AdminPayoutsPage}"
            Route="payouts" />
        <ShellContent
            Title="Gastos"
            Icon="nav_receipt.svg"
            ContentTemplate="{DataTemplate admin:AdminTripExpensesPage}"
            Route="expenses" />
        <ShellContent
            Title="Avisos"
            Icon="nav_bell.svg"
            ContentTemplate="{DataTemplate client:ClientNotificationsPage}"
            Route="notifications" />
    </TabBar>

</Shell>