<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <!-- Surface colors -->
    <Color x:Key="Surface">#faf8ff</Color>
    <Color x:Key="SurfaceDim">#d2d9f4</Color>
    <Color x:Key="SurfaceBright">#faf8ff</Color>
    <Color x:Key="SurfaceContainerLowest">#ffffff</Color>
    <Color x:Key="SurfaceContainerLow">#f2f3ff</Color>
    <Color x:Key="SurfaceContainer">#eaedff</Color>
    <Color x:Key="SurfaceContainerHigh">#e2e7ff</Color>
    <Color x:Key="SurfaceContainerHighest">#dae2fd</Color>
    <Color x:Key="SurfaceVariant">#dae2fd</Color>
    <Color x:Key="SurfaceTint">#2e6a41</Color>

    <!-- On surface colors -->
    <Color x:Key="OnSurface">#131b2e</Color>
    <Color x:Key="OnSurfaceVariant">#404941</Color>
    <Color x:Key="InverseSurface">#283044</Color>
    <Color x:Key="InverseOnSurface">#eef0ff</Color>

    <!-- Outline colors -->
    <Color x:Key="Outline">#717970</Color>
    <Color x:Key="OutlineVariant">#c0c9be</Color>

    <!-- Background colors -->
    <Color x:Key="Background">#faf8ff</Color>
    <Color x:Key="OnBackground">#131b2e</Color>

    <!-- Primary colors -->
    <Color x:Key="Primary">#003b1b</Color>
    <Color x:Key="OnPrimary">#ffffff</Color>
    <Color x:Key="PrimaryContainer">#14532d</Color>
    <Color x:Key="OnPrimaryContainer">#87c695</Color>
    <Color x:Key="InversePrimary">#96d5a3</Color>
    <Color x:Key="PrimaryFixed">#b1f2be</Color>
    <Color x:Key="PrimaryFixedDim">#96d5a3</Color>
    <Color x:Key="OnPrimaryFixed">#00210d</Color>
    <Color x:Key="OnPrimaryFixedVariant">#12512c</Color>
    <Color x:Key="PrimaryDark">#12512c</Color>
    <Color x:Key="PrimaryDarkText">#ffffff</Color>

    <!-- Secondary colors -->
    <Color x:Key="Secondary">#006c49</Color>
    <Color x:Key="OnSecondary">#ffffff</Color>
    <Color x:Key="SecondaryContainer">#6cf8bb</Color>
    <Color x:Key="OnSecondaryContainer">#00714d</Color>
    <Color x:Key="SecondaryFixed">#6ffbbe</Color>
    <Color x:Key="SecondaryFixedDim">#4edea3</Color>
    <Color x:Key="OnSecondaryFixed">#002113</Color>
    <Color x:Key="OnSecondaryFixedVariant">#005236</Color>
    <Color x:Key="SecondaryDarkText">#00714d</Color>

    <!-- Tertiary colors -->
    <Color x:Key="Tertiary">#28352e</Color>
    <Color x:Key="OnTertiary">#ffffff</Color>
    <Color x:Key="TertiaryContainer">#3f4b44</Color>
    <Color x:Key="OnTertiaryContainer">#adbbb1</Color>
    <Color x:Key="TertiaryFixed">#d8e6dc</Color>
    <Color x:Key="TertiaryFixedDim">#bccac0</Color>
    <Color x:Key="OnTertiaryFixed">#121e18</Color>
    <Color x:Key="OnTertiaryFixedVariant">#3d4a43</Color>

    <!-- Error colors -->
    <Color x:Key="Error">#ba1a1a</Color>
    <Color x:Key="OnError">#ffffff</Color>
    <Color x:Key="ErrorContainer">#ffdad6</Color>
    <Color x:Key="OnErrorContainer">#93000a</Color>

    <!-- Legacy neutral colors -->
    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#131b2e</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <!-- Brushes -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />

</ResourceDictionary>
