<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminBookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    Title="Reservas"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Admin · Reservas"
            PageTitle="Reservas"
            ShowBack="False"
            ShowLogout="True"
            LogoutRequested="OnLogoutClicked" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8" Padding="20,0,20,0">

            <Border Grid.Row="0" Style="{StaticResource AdminCard}" Padding="12,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="🔍" FontSize="15" VerticalOptions="Center" />
                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           Placeholder="Buscar por viaje, cliente o pasajero"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource OnSurface}"
                           PlaceholderColor="{StaticResource OnSurfaceVariant}"
                           FontSize="14"
                           HeightRequest="44"
                           TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>

            <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <Button x:Name="ChipPending"
                            Text="Pendientes"
                            Style="{StaticResource AdminChip}"
                            Clicked="OnStatusChipClicked"
                            CommandParameter="Pending" />
                    <Button x:Name="ChipConfirmed"
                            Text="Confirmadas"
                            Style="{StaticResource AdminChip}"
                            Clicked="OnStatusChipClicked"
                            CommandParameter="Confirmed" />
                    <Button x:Name="ChipCancelled"
                            Text="Canceladas"
                            Style="{StaticResource AdminChip}"
                            Clicked="OnStatusChipClicked"
                            CommandParameter="Cancelled" />
                    <Button x:Name="ChipAll"
                            Text="Todas"
                            Style="{StaticResource AdminChip}"
                            Clicked="OnStatusChipClicked"
                            CommandParameter="All" />
                </HorizontalStackLayout>
            </ScrollView>

            <Border Grid.Row="2" Style="{StaticResource AdminCard}" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                    <Label Text="Salida desde"
                           FontSize="13"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           VerticalOptions="Center" />
                    <DatePicker x:Name="FromDatePicker"
                                Grid.Column="1"
                                Format="dd/MM/yyyy"
                                DateSelected="OnFromDateSelected"
                                VerticalOptions="Center" />
                    <Button x:Name="ClearDateBtn"
                            Grid.Column="2"
                            Text="Limpiar"
                            Style="{StaticResource AdminChip}"
                            Clicked="OnClearDateClicked"
                            VerticalOptions="Center" />
                </Grid>
            </Border>

            <Grid Grid.Row="3">
                <ActivityIndicator x:Name="Loading"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Margin="0,10"
                                   VerticalOptions="Start"
                                   HorizontalOptions="Center" />

                <RefreshView x:Name="BookingsRefresh" Refreshing="OnRefreshing">
                    <CollectionView x:Name="BookingsList"
                                    SelectionMode="None"
                                    Footer=" ">
                        <CollectionView.EmptyView>
                            <Label Text="Aún no hay reservas."
                                   FontSize="14"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   HorizontalTextAlignment="Center"
                                   Margin="20,24" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:Booking">
                                <Border Style="{StaticResource AdminCard}" Margin="0,4">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Trip.Title}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource OnSurface}"
                                                   LineBreakMode="TailTruncation" />
                                            <Border Grid.Column="1"
                                                    Padding="8,3"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 100"
                                                    BackgroundColor="{StaticResource SurfaceContainerHigh}">
                                                <Label Text="{Binding Status}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>
                                        </Grid>

                                        <Label Text="{Binding User.Name}"
                                               FontSize="13"
                                               TextColor="{StaticResource OnSurfaceVariant}" />

                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding NumberOfSeats}" FontSize="13" />
                                            <Label Text="asientos ·" FontSize="13" />
                                            <Label Text="{Binding TotalAmount, StringFormat='{0:C}'}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Primary}" />
                                        </HorizontalStackLayout>

                                        <Button Text="Ver detalle"
                                                Style="{StaticResource AdminTonalButton}"
                                                FontSize="14"
                                                Clicked="OnDetailClicked"
                                                CommandParameter="{Binding .}"
                                                Margin="0,2,0,0" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
