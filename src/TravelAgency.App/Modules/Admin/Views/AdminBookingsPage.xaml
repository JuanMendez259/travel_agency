<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminBookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    Title="Reservas">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,*">
        <SearchBar x:Name="SearchBar"
                   Grid.Row="0"
                   Placeholder="Buscar por viaje, cliente o pasajero"
                   TextChanged="OnSearchTextChanged" />

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="12,4" Spacing="8">
                <Button x:Name="ChipPending" Text="Pendientes" Clicked="OnStatusChipClicked" CommandParameter="Pending"
                        FontSize="13" Padding="16,6" CornerRadius="16" />
                <Button x:Name="ChipConfirmed" Text="Confirmadas" Clicked="OnStatusChipClicked" CommandParameter="Confirmed"
                        FontSize="13" Padding="16,6" CornerRadius="16" />
                <Button x:Name="ChipCancelled" Text="Canceladas" Clicked="OnStatusChipClicked" CommandParameter="Cancelled"
                        FontSize="13" Padding="16,6" CornerRadius="16" />
                <Button x:Name="ChipAll" Text="Todas" Clicked="OnStatusChipClicked" CommandParameter="All"
                        FontSize="13" Padding="16,6" CornerRadius="16" />
            </HorizontalStackLayout>
        </ScrollView>

        <HorizontalStackLayout Grid.Row="2" Padding="12,2" Spacing="8">
            <Label Text="Salida desde:" VerticalOptions="Center" FontSize="13" />
            <DatePicker x:Name="FromDatePicker"
                        Format="dd/MM/yyyy"
                        DateSelected="OnFromDateSelected"
                        VerticalOptions="Center" />
            <Button x:Name="ClearDateBtn"
                    Text="Limpiar"
                    Clicked="OnClearDateClicked"
                    FontSize="13" Padding="12,4" CornerRadius="12"
                    VerticalOptions="Center" />
        </HorizontalStackLayout>

        <ActivityIndicator x:Name="Loading"
                           Grid.Row="3"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="0,10"
                           VerticalOptions="Start"
                           HorizontalOptions="Center" />

        <RefreshView x:Name="BookingsRefresh"
                     Grid.Row="3"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="BookingsList"
                            SelectionMode="None"
                            Footer=" "
                            EmptyView="Aún no hay reservas.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <Border Margin="10,5" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}">
                        <VerticalStackLayout Padding="12" Spacing="4">
                            <Label Text="{Binding Trip.Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding User.Name}" FontSize="14" TextColor="Gray" />
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding NumberOfSeats}" />
                                <Label Text="asientos ·" />
                                <Label Text="{Binding TotalAmount, StringFormat='{0:C}'}" FontAttributes="Bold" />
                                <Label Text="·" />
                                <Label Text="{Binding Status}" TextColor="{AppThemeBinding Light=#1976D2, Dark=#82B1FF}" />
                            </HorizontalStackLayout>
                            <Button Text="Ver detalle"
                                    Clicked="OnDetailClicked"
                                    CommandParameter="{Binding .}"
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>