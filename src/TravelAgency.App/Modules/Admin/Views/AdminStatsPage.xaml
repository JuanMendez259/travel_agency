<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminStatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    Title="Estadísticas"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Admin · Estadísticas"
            PageTitle="Estadísticas"
            ShowBack="False"
            ShowLogout="True"
            LogoutRequested="OnLogoutClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,32" Spacing="16">

                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                    <Border Style="{StaticResource AdminCard}" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Border WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    HorizontalOptions="Start">
                                <Label Text="🧭" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="TripsKpi"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Viajes"
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource AdminCard}" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Border WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    HorizontalOptions="Start">
                                <Label Text="💺" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="SeatsKpi"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Asientos vendidos"
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AdminCard}" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Border WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    HorizontalOptions="Start">
                                <Label Text="💵" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="RevenueKpi"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Ingresos"
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource AdminCard}" Padding="14">
                        <VerticalStackLayout Spacing="6">
                            <Border WidthRequest="36"
                                    HeightRequest="36"
                                    Padding="0"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    HorizontalOptions="Start">
                                <Label Text="📊" FontSize="17" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <Label x:Name="OccupancyKpi"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="Ocupación general"
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Ingresos por mes"
                               Style="{StaticResource AdminCardTitle}" />
                        <GraphicsView x:Name="RevenueChart" HeightRequest="190" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Ocupación por viaje"
                               Style="{StaticResource AdminCardTitle}" />
                        <VerticalStackLayout x:Name="OccupancyList" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TripOccupancy">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Detail}"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}" />
                                        <ProgressBar Progress="{Binding Progress}"
                                                     HeightRequest="8"
                                                     ProgressColor="{StaticResource Primary}" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Top destinos"
                               Style="{StaticResource AdminCardTitle}" />
                        <VerticalStackLayout x:Name="DestinationsList" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:TopDestination">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding Destination}"
                                               FontSize="14"
                                               LineBreakMode="TailTruncation" />
                                        <Border Grid.Column="1"
                                                Padding="8,3"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 100"
                                                BackgroundColor="{StaticResource SurfaceContainerHigh}">
                                            <Label Text="{Binding SeatsLabel}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource Primary}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
