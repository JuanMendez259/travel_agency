<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminStatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    Title="Estadísticas">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="14">

            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#26304A}">
                    <VerticalStackLayout Padding="12" Spacing="2">
                        <Label x:Name="TripsKpi" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Viajes" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Column="1" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#E6F7EE, Dark=#1F3B2D}">
                    <VerticalStackLayout Padding="12" Spacing="2">
                        <Label x:Name="SeatsKpi" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Asientos vendidos" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#FFF4E5, Dark=#4A3826}">
                    <VerticalStackLayout Padding="12" Spacing="2">
                        <Label x:Name="RevenueKpi" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Ingresos" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F3E8FF, Dark=#3B2D4A}">
                    <VerticalStackLayout Padding="12" Spacing="2">
                        <Label x:Name="OccupancyKpi" FontSize="22" FontAttributes="Bold" HorizontalOptions="Center" />
                        <Label Text="Ocupación general" FontSize="12" TextColor="Gray" HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Border>
            </Grid>

            <Label Text="Ingresos por mes" FontSize="16" FontAttributes="Bold" Margin="0,6,0,0" />
            <Border StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#26282B}">
                <GraphicsView x:Name="RevenueChart" HeightRequest="190" />
            </Border>

            <Label Text="Ocupación por viaje" FontSize="16" FontAttributes="Bold" Margin="0,6,0,0" />
            <VerticalStackLayout x:Name="OccupancyList" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TripOccupancy">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}" FontAttributes="Bold" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding Detail}" FontSize="12" TextColor="Gray" />
                            <ProgressBar Progress="{Binding Progress}" HeightRequest="8" />
                        </VerticalStackLayout>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Top destinos" FontSize="16" FontAttributes="Bold" Margin="0,6,0,0" />
            <VerticalStackLayout x:Name="DestinationsList" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TopDestination">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="{Binding Destination}" LineBreakMode="TailTruncation" />
                            <Label Grid.Column="1" Text="{Binding SeatsLabel}" TextColor="#1976D2" FontAttributes="Bold" FontSize="12" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>