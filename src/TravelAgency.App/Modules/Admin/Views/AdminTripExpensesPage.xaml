<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripExpensesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Gastos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Gastos de Viaje" FontSize="20" FontAttributes="Bold" />
            <Label Text="Registra los gastos e inversiones de cada viaje para llevar el control del dinero invertido."
                   FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />

            <Label Text="Viaje" Margin="0,6,0,0" />
            <Picker x:Name="TripPicker" SelectedIndexChanged="OnTripChanged" />

            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                    BackgroundColor="{StaticResource SurfaceContainerLow}" Padding="14,10">
                <VerticalStackLayout Spacing="1">
                    <Label Text="Inversion en Viaje" FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                    <Label x:Name="TripTitleLabel" Text="—" FontSize="17" FontAttributes="Bold"
                           TextColor="{StaticResource OnSurface}" />
                </VerticalStackLayout>
            </Border>

            <BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" Margin="0,12,0,4" />

            <Label x:Name="FormTitleLabel" Text="Agregar gasto o inversion" FontSize="17" FontAttributes="Bold" />

            <Label Text="Concepto o Descripcion de gasto" />
            <Entry x:Name="ConceptEntry" Placeholder="Ej. Renta de autobus" />

            <Label Text="Cantidad" />
            <Entry x:Name="AmountEntry" Placeholder="Ej. 1500.00" Keyboard="Numeric" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="0,6,0,0">
                <Button x:Name="AddButton" Text="+" FontSize="24" FontAttributes="Bold"
                        Clicked="OnAddClicked" BackgroundColor="{StaticResource Primary}" TextColor="White" />
                <Button x:Name="CancelEditButton" Grid.Column="1" Text="Cancelar" Clicked="OnCancelEditClicked"
                        IsVisible="False" BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        TextColor="{StaticResource OnSurface}" />
            </Grid>

            <Label x:Name="FeedbackLabel" FontSize="13" IsVisible="False" />

            <BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" Margin="0,20,0,10" />

            <Label Text="Seccion Gastos" FontSize="17" FontAttributes="Bold" />
            <Label x:Name="CountLabel" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />

            <VerticalStackLayout x:Name="ExpensesLayout" Spacing="8" Margin="0,6,0,0" />

            <Label x:Name="EmptyLabel"
                   Text="Todavía no hay gastos registrados para este viaje."
                   FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" IsVisible="False" />

            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0"
                    BackgroundColor="{StaticResource SecondaryContainer}" Padding="14,10" Margin="0,10,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Total" FontSize="16" FontAttributes="Bold"
                           TextColor="{StaticResource OnSecondaryContainer}" VerticalOptions="Center" />
                    <Label x:Name="TotalLabel" Grid.Column="1" Text="$0.00" FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource OnSecondaryContainer}" VerticalOptions="Center" />
                </Grid>
            </Border>

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
