<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripSeatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mapa de asientos"
    BackgroundColor="{StaticResource Surface}">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <!-- Contexto del viaje -->
        <Border Grid.Row="0"
                Margin="16,12,16,8"
                Padding="16"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{StaticResource Primary}">
            <Border.Shadow>
                <Shadow Brush="#0F172A" Opacity="0.12" Radius="12" Offset="0,3" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Border WidthRequest="42" HeightRequest="42"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource SecondaryContainer}"
                        VerticalOptions="Center">
                    <Label Text="🚌" FontSize="22"
                           HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                    <Label x:Name="TripLabel"
                           FontSize="18" FontAttributes="Bold"
                           TextColor="{StaticResource OnPrimary}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label x:Name="SummaryLabel"
                           FontSize="12"
                           TextColor="{StaticResource OnPrimaryContainer}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <RefreshView x:Name="SeatsRefresh" Refreshing="OnRefreshing">
                <ScrollView>
                    <VerticalStackLayout Padding="16,0,16,24" Spacing="12">

                        <!-- Leyenda compacta de estados -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border WidthRequest="20" HeightRequest="20"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{StaticResource SurfaceContainerHighest}" />
                                    <Label Text="Libre" FontSize="11"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Border WidthRequest="20" HeightRequest="20"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="#DBB92A" />
                                    <Label Text="Ocupado" FontSize="11"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Border WidthRequest="20" HeightRequest="20"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{StaticResource Secondary}" />
                                    <Label Text="Check-in" FontSize="11"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Distribución del autobús -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource SurfaceContainerLowest}"
                                Padding="16">
                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Opacity="0.05" Radius="10" Offset="0,2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="💺" FontSize="18" VerticalOptions="Center" />
                                        <Label Text="Distribución de asientos"
                                               FontSize="16" FontAttributes="Bold"
                                               TextColor="{StaticResource OnSurface}"
                                               VerticalOptions="Center"
                                               SemanticProperties.HeadingLevel="Level2" />
                                    </HorizontalStackLayout>
                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                            Padding="9,4"
                                            VerticalOptions="Center">
                                        <Label x:Name="FloorBadgeLabel"
                                               Text="Planta única"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource OnSurfaceVariant}" />
                                    </Border>
                                </Grid>

                                <HorizontalStackLayout x:Name="FloorSelector"
                                                       Spacing="8"
                                                       HorizontalOptions="Center"
                                                       IsVisible="False">
                                    <Button x:Name="Floor1Button" Text="Piso 1" Clicked="OnFloor1Clicked"
                                            FontSize="13" FontAttributes="Bold"
                                            CornerRadius="16" Padding="18,6"
                                            MinimumHeightRequest="44"
                                            BackgroundColor="{StaticResource Primary}"
                                            TextColor="{StaticResource OnPrimary}" />
                                    <Button x:Name="Floor2Button" Text="Piso 2" Clicked="OnFloor2Clicked"
                                            FontSize="13" FontAttributes="Bold"
                                            CornerRadius="16" Padding="18,6"
                                            MinimumHeightRequest="44"
                                            BackgroundColor="{StaticResource SurfaceContainerHighest}"
                                            TextColor="{StaticResource OnSurface}" />
                                </HorizontalStackLayout>

                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 24"
                                        BackgroundColor="{StaticResource SurfaceContainerLow}"
                                        Padding="12"
                                        HorizontalOptions="Center"
                                        MaximumWidthRequest="420">
                                    <VerticalStackLayout Spacing="10">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 18"
                                                BackgroundColor="{StaticResource SurfaceContainer}"
                                                Padding="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="🏎️" FontSize="16" VerticalOptions="Center" />
                                                    <Label Text="Cabina del conductor"
                                                           FontSize="11" FontAttributes="Bold"
                                                           TextColor="{StaticResource OnSurface}"
                                                           VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                                    <Label Text="Puerta frontal" FontSize="10" FontAttributes="Bold"
                                                           TextColor="{StaticResource OnSurfaceVariant}"
                                                           VerticalOptions="Center" />
                                                    <Label Text="🔒" FontSize="12" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>

                                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
                                            <Label Text="Fila izq." FontSize="10" FontAttributes="Bold"
                                                   TextColor="{StaticResource Outline}"
                                                   HorizontalTextAlignment="End" />
                                            <Label Grid.Column="1" Text="Pasillo" FontSize="10" FontAttributes="Bold"
                                                   TextColor="{StaticResource Secondary}"
                                                   HorizontalTextAlignment="Center" />
                                            <Label Grid.Column="2" Text="Fila der." FontSize="10" FontAttributes="Bold"
                                                   TextColor="{StaticResource Outline}" />
                                        </Grid>

                                        <VerticalStackLayout x:Name="RowsContainer" Spacing="8" />

                                        <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,0">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="🧳" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="Maletero bajo piso" FontSize="11"
                                                       TextColor="{StaticResource Outline}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                                <Label Text="🚻" FontSize="14" VerticalOptions="Center" />
                                                <Label Text="Sanitario" FontSize="11"
                                                       TextColor="{StaticResource Outline}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- Nombres y estado de check-in: información exclusiva del staff -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource SurfaceContainerLowest}"
                                Padding="16">
                            <Border.Shadow>
                                <Shadow Brush="#0F172A" Opacity="0.05" Radius="10" Offset="0,2" />
                            </Border.Shadow>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="Detalle de ocupación"
                                           FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource OnSurface}"
                                           SemanticProperties.HeadingLevel="Level2" />
                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="{StaticResource SurfaceContainerLow}"
                                            Padding="8,3">
                                        <Label x:Name="OccupiedCountLabel" Text="0 ocupados"
                                               FontSize="11" FontAttributes="Bold"
                                               TextColor="{StaticResource OnSurfaceVariant}" />
                                    </Border>
                                </Grid>
                                <VerticalStackLayout x:Name="OccupiedList" Spacing="8" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <ActivityIndicator x:Name="Loading"
                               Grid.Row="1"
                               IsRunning="False"
                               IsVisible="False"
                               VerticalOptions="Start"
                               HorizontalOptions="Center"
                               Margin="0,12" />
        </Grid>
    </Grid>
</ContentPage>
