<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripSeatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    Title="Mapa de asientos"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Operación"
            PageTitle="Mapa de asientos"
            ShowBack="True"
            ShowLogout="True"
            LogoutRequested="OnLogoutClicked" />

        <Border
            Grid.Row="1"
            Margin="20,0,20,8"
            Padding="14"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource PrimaryContainer}" Offset="0.0" />
                    <GradientStop Color="{StaticResource Primary}" Offset="0.78" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="{StaticResource OnSurface}" Offset="0,6" Radius="18" Opacity="0.16" />
            </Border.Shadow>

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="11">
                <Border
                    WidthRequest="42"
                    HeightRequest="42"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{StaticResource SecondaryContainer}"
                    VerticalOptions="Center">
                    <Label
                        Text="🚌"
                        FontSize="20"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>

                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <Label
                        x:Name="TripLabel"
                        FontFamily="OpenSansSemibold"
                        FontSize="18"
                        FontAttributes="Bold"
                        TextColor="{StaticResource OnPrimary}"
                        LineBreakMode="TailTruncation"
                        SemanticProperties.HeadingLevel="Level2" />
                    <Label
                        x:Name="SummaryLabel"
                        FontSize="11"
                        LineHeight="1.45"
                        TextColor="{StaticResource OnPrimaryContainer}" />
                    <Label
                        x:Name="FloorCapacityLabel"
                        FontSize="11"
                        LineHeight="1.45"
                        TextColor="{StaticResource OnPrimaryContainer}"
                        IsVisible="False" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <RefreshView x:Name="SeatsRefresh" Refreshing="OnRefreshing">
                <ScrollView>
                    <VerticalStackLayout Padding="20,4,20,32" Spacing="12">

                        <Border
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 12"
                            BackgroundColor="{StaticResource SurfaceContainerLow}"
                            Padding="12,10">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                    <Border
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{StaticResource SurfaceContainerHighest}" />
                                    <Label
                                        Text="Libre"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="11"
                                        TextColor="{StaticResource OnSurfaceVariant}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                    <Border
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="#DBB92A" />
                                    <Label
                                        Text="Ocupado"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="11"
                                        TextColor="{StaticResource OnSurfaceVariant}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                                    <Border
                                        WidthRequest="20"
                                        HeightRequest="20"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 6"
                                        BackgroundColor="{StaticResource Secondary}" />
                                    <Label
                                        Text="Check-in"
                                        FontFamily="OpenSansSemibold"
                                        FontSize="11"
                                        TextColor="{StaticResource OnSurfaceVariant}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource AdminCard}">
                            <VerticalStackLayout Spacing="12">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                        <Label Text="💺" FontSize="17" VerticalOptions="Center" />
                                        <Label
                                            Text="Distribución de asientos"
                                            Style="{StaticResource AdminCardTitle}"
                                            VerticalOptions="Center"
                                            SemanticProperties.HeadingLevel="Level2" />
                                    </HorizontalStackLayout>

                                    <Border
                                        Grid.Column="1"
                                        Padding="9,4"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                        VerticalOptions="Center">
                                        <Label
                                            x:Name="FloorBadgeLabel"
                                            Text="Planta única"
                                            Style="{StaticResource AdminBadge}"
                                            Padding="0"
                                            BackgroundColor="Transparent" />
                                    </Border>
                                </Grid>

                                <HorizontalStackLayout
                                    x:Name="FloorSelector"
                                    Spacing="8"
                                    HorizontalOptions="Center"
                                    IsVisible="False">
                                    <Button
                                        x:Name="Floor1Button"
                                        Text="Piso 1"
                                        Clicked="OnFloor1Clicked"
                                        Style="{StaticResource AdminChip}"
                                        Padding="18,6"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="{StaticResource OnPrimary}" />
                                    <Button
                                        x:Name="Floor2Button"
                                        Text="Piso 2"
                                        Clicked="OnFloor2Clicked"
                                        Style="{StaticResource AdminChip}"
                                        Padding="18,6"
                                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                        TextColor="{StaticResource OnSurface}" />
                                </HorizontalStackLayout>

                                <Border
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 24"
                                    BackgroundColor="{StaticResource SurfaceContainerLow}"
                                    Padding="8"
                                    HorizontalOptions="Center"
                                    MaximumWidthRequest="420">
                                    <VerticalStackLayout Spacing="10">
                                        <Border
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 18"
                                            BackgroundColor="{StaticResource SurfaceContainer}"
                                            Padding="12">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label Text="🏎️" FontSize="15" VerticalOptions="Center" />
                                                    <Label
                                                        Text="Cabina del conductor"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="10"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource OnSurface}"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                                    <Label
                                                        Text="Puerta frontal"
                                                        FontFamily="OpenSansSemibold"
                                                        FontSize="9"
                                                        FontAttributes="Bold"
                                                        TextColor="{StaticResource OnSurfaceVariant}"
                                                        VerticalOptions="Center" />
                                                    <Label Text="🔒" FontSize="12" VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Grid>
                                        </Border>

                                        <Grid ColumnDefinitions="*,24,*" ColumnSpacing="4">
                                            <Label
                                                Text="Fila izq."
                                                FontFamily="OpenSansSemibold"
                                                FontSize="9"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Outline}"
                                                HorizontalTextAlignment="End"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="1"
                                                Text="↕"
                                                FontSize="11"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Secondary}"
                                                HorizontalTextAlignment="Center"
                                                VerticalOptions="Center" />
                                            <Label
                                                Grid.Column="2"
                                                Text="Fila der."
                                                FontFamily="OpenSansSemibold"
                                                FontSize="9"
                                                FontAttributes="Bold"
                                                TextColor="{StaticResource Outline}"
                                                VerticalOptions="Center" />
                                        </Grid>

                                        <VerticalStackLayout x:Name="RowsContainer" Spacing="8" />

                                        <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,0">
                                            <HorizontalStackLayout Spacing="5">
                                                <Label Text="🧳" FontSize="13" VerticalOptions="Center" />
                                                <Label
                                                    Text="Maletero bajo piso"
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="10"
                                                    TextColor="{StaticResource Outline}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                            <HorizontalStackLayout Grid.Column="1" Spacing="5">
                                                <Label Text="🚻" FontSize="13" VerticalOptions="Center" />
                                                <Label
                                                    Text="Sanitario"
                                                    FontFamily="OpenSansSemibold"
                                                    FontSize="10"
                                                    TextColor="{StaticResource Outline}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <Border Style="{StaticResource AdminCard}">
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label
                                        Text="Detalle de ocupación"
                                        Style="{StaticResource AdminCardTitle}"
                                        VerticalOptions="Center"
                                        SemanticProperties.HeadingLevel="Level2" />
                                    <Border
                                        Grid.Column="1"
                                        Padding="8,3"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 10"
                                        BackgroundColor="{StaticResource SurfaceContainerLow}"
                                        VerticalOptions="Center">
                                        <Label
                                            x:Name="OccupiedCountLabel"
                                            Text="0 ocupados"
                                            Style="{StaticResource AdminBadge}"
                                            Padding="0"
                                            BackgroundColor="Transparent" />
                                    </Border>
                                </Grid>
                                <VerticalStackLayout x:Name="OccupiedList" Spacing="8" />
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </RefreshView>

            <ActivityIndicator
                x:Name="Loading"
                IsRunning="False"
                IsVisible="False"
                VerticalOptions="Start"
                HorizontalOptions="Center"
                Margin="0,12" />
        </Grid>
    </Grid>
</ContentPage>
