<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TravelAgency.App.Controls"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    Title="Detalle del viaje"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Gestión de viajes"
            PageTitle="Detalle del viaje"
            ShowBack="True"
            ShowLogout="True"
            BackRequested="OnBackClicked"
            LogoutRequested="OnLogoutClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,32" Spacing="16">

                <Border Style="{StaticResource AdminCard}" Padding="0" StrokeShape="RoundRectangle 20">
                    <Grid RowDefinitions="Auto,Auto">
                        <Grid Grid.Row="0" HeightRequest="190">
                            <Border StrokeThickness="0">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="{StaticResource PrimaryContainer}" Offset="0.0" />
                                        <GradientStop Color="{StaticResource Secondary}" Offset="1.0" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>

                            <Label Text="🧭"
                                   FontSize="76"
                                   Opacity="0.85"
                                   HorizontalOptions="End"
                                   VerticalOptions="End"
                                   Margin="0,0,20,16" />

                            <controls:NetworkImage x:Name="TripImage" Aspect="AspectFill" />

                            <Border HorizontalOptions="Start"
                                    VerticalOptions="End"
                                    Margin="14"
                                    Padding="10,6"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 100"
                                    BackgroundColor="{StaticResource SurfaceContainerLowest}">
                                <HorizontalStackLayout Spacing="6">
                                    <Label x:Name="TransportEmojiLabel" FontSize="13" VerticalOptions="Center" />
                                    <Label x:Name="TransportLabel"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="11"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <VerticalStackLayout Grid.Row="1" Padding="16" Spacing="12">
                            <Label x:Name="TitleLabel"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource OnSurface}" />

                            <VerticalStackLayout Spacing="6">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="📍" FontSize="14" VerticalOptions="Center" />
                                    <Label x:Name="DestinationLabel"
                                           Grid.Column="1"
                                           FontSize="13"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                    <Label Text="🗓" FontSize="14" VerticalOptions="Center" />
                                    <Label x:Name="DatesLabel"
                                           Grid.Column="1"
                                           FontSize="13"
                                           TextColor="{StaticResource OnSurfaceVariant}"
                                           VerticalOptions="Center" />
                                </Grid>
                            </VerticalStackLayout>

                            <Label x:Name="PriceLabel"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />

                            <HorizontalStackLayout Spacing="8">
                                <Border x:Name="StatusBadge"
                                        Padding="12,6"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 100"
                                        BackgroundColor="{StaticResource SuccessContainer}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label x:Name="StatusDot"
                                               Text="●"
                                               FontSize="10"
                                               TextColor="{StaticResource Secondary}"
                                               VerticalOptions="Center" />
                                        <Label x:Name="StatusLabel"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource Secondary}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Padding="12,6"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 100"
                                        BackgroundColor="{StaticResource SurfaceContainerLow}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="👥" FontSize="11" VerticalOptions="Center" />
                                        <Label x:Name="HeroCapacityLabel"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="11"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AdminCard}" Padding="8,12">
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="0">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="VENDIDOS"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   TextColor="{StaticResource Outline}"
                                   HorizontalOptions="Center" />
                            <Label x:Name="SoldLabel"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <Label Text="DISPONIBLES"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   TextColor="{StaticResource Outline}"
                                   HorizontalOptions="Center" />
                            <Label x:Name="AvailableLabel"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="2" Spacing="4">
                            <Label Text="CAPACIDAD"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="10"
                                   TextColor="{StaticResource Outline}"
                                   HorizontalOptions="Center" />
                            <Label x:Name="CapacityLabel"
                                   FontSize="26"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}"
                                   HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border IsVisible="{Binding Source={x:Reference CancellationLabel}, Path=IsVisible}"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 14"
                        BackgroundColor="{StaticResource SuccessContainer}"
                        Padding="14,12"
                        Margin="0,-6,0,0">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <Label Text="ℹ️" FontSize="13" VerticalOptions="Start" />
                        <Label x:Name="CancellationLabel"
                               Grid.Column="1"
                               FontSize="12"
                               TextColor="{StaticResource PrimaryContainer}"
                               IsVisible="False" />
                    </Grid>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Descripción" Style="{StaticResource AdminCardTitle}" />
                        <Label x:Name="DescriptionLabel"
                               FontSize="14"
                               LineHeight="1.5"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Hotel y opciones" Style="{StaticResource AdminCardTitle}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="🏨" FontSize="15" VerticalOptions="Start" />
                            <Label x:Name="HotelSummaryLabel"
                                   Grid.Column="1"
                                   FontSize="13"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainerHigh}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="🎟️" FontSize="15" VerticalOptions="Start" />
                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                <Label x:Name="OptionsHeader"
                                       Text="Opciones del viaje"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource OnSurface}" />
                                <Label x:Name="OptionsSummaryLabel"
                                       FontSize="11"
                                       TextColor="{StaticResource Outline}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout x:Name="OptionsLayout" Spacing="6" />

                        <Button x:Name="ManageOptionsButton"
                                Text="🎟️ Administrar opciones"
                                Style="{StaticResource AdminTonalButton}"
                                Clicked="OnManageOptionsClicked"
                                Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}"
                        IsVisible="{Binding Source={x:Reference CapacityRequestsHeader}, Path=IsVisible}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="CapacityRequestsHeader"
                               Text="Solicitudes de cupo"
                               Style="{StaticResource AdminCardTitle}"
                               IsVisible="False" />
                        <Label Text="Peticiones de clientes que aún no tienen reserva."
                               FontSize="11"
                               TextColor="{StaticResource Outline}" />
                        <VerticalStackLayout x:Name="CapacityRequestsLayout" Spacing="8" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}"
                        IsVisible="{Binding Source={x:Reference PassengersHeader}, Path=IsVisible}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="PassengersHeader"
                               Text="Pasajeros"
                               Style="{StaticResource AdminCardTitle}"
                               IsVisible="False" />
                        <VerticalStackLayout x:Name="PassengersLayout" Spacing="14" />
                        <BoxView HeightRequest="1" Color="{StaticResource SurfaceContainerHigh}" />
                        <Label x:Name="PassengersTotalLabel"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,0,0,4">
                            <Label Text="Operación" Style="{StaticResource AdminCardTitle}" />
                            <Label Grid.Column="1"
                                   Text="Acciones del viaje"
                                   FontSize="10"
                                   TextColor="{StaticResource Outline}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Button x:Name="PaymentsButton"
                                    Text="💳 Reservas y pagos"
                                    Style="{StaticResource AdminTonalButton}"
                                    Clicked="OnPaymentsClicked" />
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource Outline}"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0"
                                   InputTransparent="True"
                                   IsVisible="{Binding Source={x:Reference PaymentsButton}, Path=IsVisible}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Button x:Name="MapButton"
                                    Text="🗺️ Mapa e itinerario"
                                    Style="{StaticResource AdminTonalButton}"
                                    Clicked="OnMapClicked" />
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource Outline}"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0"
                                   InputTransparent="True"
                                   IsVisible="{Binding Source={x:Reference MapButton}, Path=IsVisible}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Button x:Name="CheckinButton"
                                    Text="✅ Check-in / Salida"
                                    Style="{StaticResource AdminTonalButton}"
                                    BackgroundColor="{StaticResource Secondary}"
                                    TextColor="{StaticResource OnPrimary}"
                                    Clicked="OnCheckinClicked" />
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource OnPrimary}"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0"
                                   InputTransparent="True"
                                   IsVisible="{Binding Source={x:Reference CheckinButton}, Path=IsVisible}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Button x:Name="FinalizeButton"
                                    Text="🏁 Finalizar viaje"
                                    Style="{StaticResource AdminTonalButton}"
                                    Clicked="OnFinalizeClicked" />
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource Outline}"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0"
                                   InputTransparent="True"
                                   IsVisible="{Binding Source={x:Reference FinalizeButton}, Path=IsVisible}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                            <Button x:Name="AuditButton"
                                    Text="🕘 Historial de cambios"
                                    Style="{StaticResource AdminOutlineButton}"
                                    CornerRadius="14"
                                    Clicked="OnAuditClicked" />
                            <Label Grid.Column="1"
                                   Text="›"
                                   FontSize="20"
                                   TextColor="{StaticResource Outline}"
                                   VerticalOptions="Center"
                                   Margin="0,0,8,0"
                                   InputTransparent="True"
                                   IsVisible="{Binding Source={x:Reference AuditButton}, Path=IsVisible}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}"
                        IsVisible="{Binding Source={x:Reference EditActions}, Path=IsVisible}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Administración" Style="{StaticResource AdminCardTitle}" />
                            <Label Grid.Column="1"
                                   Text="Solo administrador"
                                   FontSize="10"
                                   TextColor="{StaticResource Outline}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid x:Name="EditActions" ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <Button Text="Editar"
                                    FontSize="12"
                                    Clicked="OnEditClicked"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource OnPrimary}"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="14"
                                    MinimumHeightRequest="44"
                                    Padding="8,0" />
                            <Button x:Name="PauseButton"
                                    Grid.Column="1"
                                    Text="Pausar"
                                    FontSize="12"
                                    Clicked="OnPauseClicked"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="14"
                                    MinimumHeightRequest="44"
                                    Padding="8,0"
                                    BackgroundColor="{StaticResource WarningContainer}"
                                    TextColor="{StaticResource OnWarningContainer}" />
                            <Button Text="Eliminar"
                                    Grid.Column="2"
                                    FontSize="12"
                                    Clicked="OnDeleteClicked"
                                    BackgroundColor="Transparent"
                                    BorderColor="{StaticResource Error}"
                                    BorderWidth="1"
                                    TextColor="{StaticResource Error}"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="14"
                                    MinimumHeightRequest="44"
                                    Padding="8,0" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="TransportUnitHeader"
                               Text="Información de la unidad"
                               Style="{StaticResource AdminCardTitle}" />
                        <Label Text="Datos para que el staff ubique el transporte."
                               FontSize="11"
                               TextColor="{StaticResource Outline}" />

                        <controls:NetworkImage x:Name="TransportUnitImage"
                                               HeightRequest="160"
                                               Aspect="AspectFill"
                                               IsVisible="False" />

                        <Label x:Name="TransportUnitPlateLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="13"
                               TextColor="{StaticResource OnSurface}"
                               IsVisible="False" />

                        <Border IsVisible="{Binding Source={x:Reference TransportUnitEmptyLabel}, Path=IsVisible}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 16"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Padding="16">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Label Text="🚐"
                                       FontSize="34"
                                       HorizontalOptions="Center" />
                                <Label x:Name="TransportUnitEmptyLabel"
                                       Text="Sin información de la unidad"
                                       FontSize="11"
                                       TextColor="{StaticResource Outline}"
                                       HorizontalOptions="Center"
                                       IsVisible="False" />
                            </VerticalStackLayout>
                        </Border>

                        <Button x:Name="AddTransportUnitButton"
                                Text="➕ Agregar información de la unidad"
                                Style="{StaticResource AdminTonalButton}"
                                Clicked="OnAddTransportUnitClicked"
                                Margin="0,2,0,0" />

                        <VerticalStackLayout x:Name="TransportUnitEditor" Spacing="10" IsVisible="False">
                            <Button Text="📷 Seleccionar foto"
                                    Style="{StaticResource AdminOutlineButton}"
                                    CornerRadius="14"
                                    Clicked="OnPickTransportImageClicked" />

                            <Image x:Name="TransportImagePreview"
                                   HeightRequest="150"
                                   Aspect="AspectFill"
                                   IsVisible="False" />

                            <Label x:Name="TransportImageNameLabel"
                                   FontSize="11"
                                   TextColor="{StaticResource Outline}"
                                   IsVisible="False" />

                            <Entry x:Name="TransportPlateEntry"
                                   Placeholder="Placas de la unidad"
                                   HeightRequest="48"
                                   BackgroundColor="{StaticResource SurfaceContainerLow}"
                                   TextColor="{StaticResource OnSurface}"
                                   PlaceholderColor="{StaticResource Outline}" />

                            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                <Button Text="Guardar"
                                        Clicked="OnSaveTransportUnitClicked"
                                        BackgroundColor="{StaticResource Primary}"
                                        TextColor="{StaticResource OnPrimary}"
                                        FontFamily="OpenSansSemibold"
                                        CornerRadius="14"
                                        MinimumHeightRequest="44" />
                                <Button Grid.Column="1"
                                        Text="Cancelar"
                                        Style="{StaticResource AdminOutlineButton}"
                                        CornerRadius="14"
                                        Clicked="OnCancelTransportUnitClicked" />
                            </Grid>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="RatingsHeader"
                               Text="Opiniones de clientes"
                               Style="{StaticResource AdminCardTitle}"
                               IsVisible="False" />
                        <Label x:Name="RatingsAverageLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="12"
                               TextColor="{StaticResource Secondary}"
                               IsVisible="False" />
                        <VerticalStackLayout x:Name="RatingsLayout" Spacing="10" />
                        <Label x:Name="RatingsEmptyLabel"
                               Text="Aún no hay opiniones."
                               FontSize="13"
                               TextColor="{StaticResource Outline}"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Button Text="Volver a mis viajes"
                        Style="{StaticResource AdminOutlineButton}"
                        CornerRadius="14"
                        Clicked="OnBackClicked"
                        Margin="0,8,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
