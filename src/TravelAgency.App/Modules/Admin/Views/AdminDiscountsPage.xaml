<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminDiscountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    Title="Descuentos"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Admin · Descuentos"
            PageTitle="Descuentos"
            ShowBack="False"
            ShowLogout="True"
            LogoutRequested="OnLogoutClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,32" Spacing="16">

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="FormTitleLabel"
                               Text="Nuevo descuento"
                               Style="{StaticResource AdminCardTitle}"
                               FontSize="18" />
                        <Label Text="Crea códigos de descuento para tus clientes. Pueden ser globales o de un viaje específico."
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}" />

                        <Label Text="Código" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Entry x:Name="CodeEntry" Placeholder="Ej. VERANO10" TextTransform="Uppercase"
                               HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Tipo de descuento" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Picker x:Name="TypePicker" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Valor" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Entry x:Name="ValueEntry" Placeholder="Ej. 10 o 100" Keyboard="Numeric"
                                       HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                                       TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                <Label Text="Tiene vigencia" FontSize="14" FontAttributes="Bold" />
                                <Label Text="Actívalo para definir fecha de inicio y fin."
                                       FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Switch x:Name="VigenciaSwitch" Grid.Column="1"
                                    Toggled="OnVigenciaToggled" VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="VigenciaFields" Spacing="8" IsVisible="False">
                            <Label Text="Fecha de inicio" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                            <DatePicker x:Name="StartDatePicker" />
                            <Label Text="Fecha de fin" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                            <DatePicker x:Name="EndDatePicker" />
                        </VerticalStackLayout>

                        <Label Text="Límite de uso" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Entry x:Name="UsageLimitEntry" Placeholder="Vacío = ilimitado" Keyboard="Numeric"
                               HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />

                        <Label Text="Alcance" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Picker x:Name="TripPicker" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Switch x:Name="ActiveSwitch" IsToggled="True" VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="Descuento activo" FontSize="14" FontAttributes="Bold" />
                                <Label Text="Si lo desactivas, deja de aplicarse."
                                       FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button x:Name="SaveButton"
                                    Text="Guardar descuento"
                                    Clicked="OnSaveClicked"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource OnPrimary}"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="16"
                                    MinimumHeightRequest="44" />
                            <Button x:Name="CancelEditButton"
                                    Grid.Column="1"
                                    Text="Cancelar edición"
                                    Clicked="OnCancelEditClicked"
                                    IsVisible="False"
                                    Style="{StaticResource AdminTonalButton}" />
                        </Grid>

                        <Label x:Name="FeedbackLabel" FontSize="13" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Descuentos registrados" Style="{StaticResource AdminCardTitle}" />
                            <Label x:Name="CountLabel"
                                   Grid.Column="1"
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="DiscountsLayout" Spacing="10" />

                        <Label x:Name="EmptyLabel"
                               Text="Todavía no hay descuentos registrados."
                               FontSize="13"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center"
                               Margin="0,12"
                               IsVisible="False" />

                        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
