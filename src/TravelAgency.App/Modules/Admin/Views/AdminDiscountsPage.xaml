<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminDiscountsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Descuentos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label Text="Descuentos" FontSize="20" FontAttributes="Bold" />
            <Label Text="Crea códigos de descuento para tus clientes. Pueden ser globales o de un viaje específico."
                   FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />

            <Label x:Name="FormTitleLabel" Text="Nuevo descuento" FontSize="17" FontAttributes="Bold" Margin="0,10,0,0" />

            <Label Text="Código" />
            <Entry x:Name="CodeEntry" Placeholder="Ej. VERANO10" TextTransform="Uppercase" />

            <Label Text="Tipo de descuento" />
            <Picker x:Name="TypePicker" />

            <Label Text="Valor" />
            <Entry x:Name="ValueEntry" Placeholder="Ej. 10 (porcentaje) o 100 (monto)" Keyboard="Numeric" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                    <Label Text="Tiene vigencia" />
                    <Label Text="Actívalo para definir fecha de inicio y fin." FontSize="12"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
                <Switch x:Name="VigenciaSwitch" Grid.Column="1" Toggled="OnVigenciaToggled" VerticalOptions="Center" />
            </Grid>
            <VerticalStackLayout x:Name="VigenciaFields" Spacing="8" IsVisible="False">
                <Label Text="Fecha de inicio" />
                <DatePicker x:Name="StartDatePicker" />
                <Label Text="Fecha de fin" />
                <DatePicker x:Name="EndDatePicker" />
            </VerticalStackLayout>

            <Label Text="Límite de uso" />
            <Entry x:Name="UsageLimitEntry" Placeholder="Vacío = ilimitado" Keyboard="Numeric" />

            <Label Text="Alcance" />
            <Picker x:Name="TripPicker" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                <Switch x:Name="ActiveSwitch" IsToggled="True" VerticalOptions="Center" />
                <VerticalStackLayout Grid.Column="1" Spacing="1">
                    <Label Text="Descuento activo" FontSize="14" FontAttributes="Bold" />
                    <Label Text="Si lo desactivas, deja de aplicarse." FontSize="12"
                           TextColor="{StaticResource OnSurfaceVariant}" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,6,0,0">
                <Button x:Name="SaveButton" Text="Guardar descuento" Clicked="OnSaveClicked"
                        BackgroundColor="{StaticResource Primary}" TextColor="White" />
                <Button x:Name="CancelEditButton" Grid.Column="1" Text="Cancelar edición"
                        Clicked="OnCancelEditClicked" IsVisible="False"
                        BackgroundColor="{StaticResource SurfaceContainerHigh}"
                        TextColor="{StaticResource OnSurface}" />
            </Grid>

            <Label x:Name="FeedbackLabel" FontSize="13" IsVisible="False" />

            <BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" Margin="0,20,0,10" />

            <Label Text="Descuentos registrados" FontSize="17" FontAttributes="Bold" />
            <Label x:Name="CountLabel" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />

            <VerticalStackLayout x:Name="DiscountsLayout" Spacing="8" Margin="0,6,0,0" />

            <Label x:Name="EmptyLabel"
                   Text="Todavía no hay descuentos registrados."
                   FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" IsVisible="False" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
