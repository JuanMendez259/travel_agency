<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripBookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    xmlns:viewmodels="clr-namespace:TravelAgency.App.Modules.Admin.ViewModels"
    Title="Reservas y Pagos"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Operación"
            PageTitle="Reservas y pagos"
            ShowBack="True"
            ShowLogout="True"
            LogoutRequested="OnLogoutClicked" />

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="8" Padding="20,0,20,0">

            <Border Grid.Row="0" Style="{StaticResource AdminCard}" Padding="12,0">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                    <Label Text="🔍" FontSize="15" VerticalOptions="Center" />
                    <Entry x:Name="SearchEntry"
                           Grid.Column="1"
                           Placeholder="Buscar por cliente o pasajero"
                           BackgroundColor="Transparent"
                           TextColor="{StaticResource OnSurface}"
                           PlaceholderColor="{StaticResource OnSurfaceVariant}"
                           FontSize="14"
                           HeightRequest="44"
                           TextChanged="OnSearchTextChanged" />
                </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource AdminCard}" Padding="12,8">
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <Label Text="Estado"
                           FontSize="13"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           VerticalOptions="Center" />
                    <Picker x:Name="StatusPicker"
                            Grid.Column="1"
                            FontSize="14"
                            SelectedIndexChanged="OnStatusChanged" />
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <ActivityIndicator x:Name="Loading"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Margin="0,10"
                                   VerticalOptions="Start"
                                   HorizontalOptions="Center" />

                <RefreshView x:Name="BookingsRefresh" Refreshing="OnRefreshing">
                    <CollectionView x:Name="BookingsList"
                                    SelectionMode="None"
                                    Footer=" ">
                        <CollectionView.EmptyView>
                            <Label Text="Este viaje todavía no tiene reservas."
                                   FontSize="14"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   HorizontalTextAlignment="Center"
                                   Margin="20,24" />
                        </CollectionView.EmptyView>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:TripBookingItem">
                                <Border Style="{StaticResource AdminCard}" Margin="0,4">
                                    <VerticalStackLayout Spacing="8">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Client}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="16"
                                                   FontAttributes="Bold"
                                                   TextColor="{StaticResource OnSurface}"
                                                   LineBreakMode="TailTruncation" />
                                            <Border Grid.Column="1"
                                                    Padding="8,3"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 100"
                                                    BackgroundColor="{StaticResource SurfaceContainerHigh}">
                                                <Label Text="{Binding Status}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="11"
                                                       FontAttributes="Bold"
                                                       TextColor="{StaticResource Primary}" />
                                            </Border>
                                        </Grid>

                                        <HorizontalStackLayout Spacing="4">
                                            <Label Text="{Binding Seats}" FontSize="13" />
                                            <Label Text="asientos ·" FontSize="13" />
                                            <Label Text="{Binding Total, StringFormat='{0:C}'}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13"
                                                   TextColor="{StaticResource Primary}" />
                                        </HorizontalStackLayout>

                                        <Label Text="{Binding BalanceText}"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}" />

                                        <Button Text="Gestionar pagos"
                                                Style="{StaticResource AdminTonalButton}"
                                                FontSize="14"
                                                Clicked="OnDetailClicked"
                                                CommandParameter="{Binding .}"
                                                Margin="0,2,0,0" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
