<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripBookingsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:TravelAgency.App.Modules.Admin.ViewModels"
    Title="Reservas y Pagos">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*">
        <ActivityIndicator x:Name="Loading"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="0,10"
                           HorizontalOptions="Center" />

        <CollectionView x:Name="BookingsList"
                        Grid.Row="1"
                        SelectionMode="None"
                        Footer=" "
                        EmptyView="Este viaje todavía no tiene reservas.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:TripBookingItem">
                    <Border Margin="10,5" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}">
                        <VerticalStackLayout Padding="12" Spacing="4">
                            <Label Text="{Binding Client}" FontSize="16" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding Seats}" />
                                <Label Text="asientos ·" />
                                <Label Text="{Binding Total, StringFormat='{0:C}'}" FontAttributes="Bold" />
                                <Label Text="·" />
                                <Label Text="{Binding Status}" TextColor="{AppThemeBinding Light=#1976D2, Dark=#82B1FF}" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding BalanceText}" FontSize="13"
                                   TextColor="{AppThemeBinding Light=#2F855A, Dark=#9AE6B4}" />
                            <Button Text="Gestionar pagos"
                                    Clicked="OnDetailClicked"
                                    CommandParameter="{Binding .}"
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>