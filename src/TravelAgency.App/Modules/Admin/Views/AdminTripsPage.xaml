<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:conv="clr-namespace:TravelAgency.App.Converters"
    xmlns:viewmodels="clr-namespace:TravelAgency.App.ViewModels"
    Title="Mis Viajes">

    <ContentPage.Resources>
        <conv:HasValueConverter x:Key="HasValue" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">
        <SearchBar x:Name="TripsSearchBar"
                   Grid.Row="0"
                   Placeholder="Buscar por destino o título"
                   TextChanged="OnTripsSearchTextChanged" />

        <ScrollView Grid.Row="1" Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Padding="12,4" Spacing="8">
                <Button x:Name="ChipTripsAll" Text="Todos" Clicked="OnTripsStatusChipClicked" CommandParameter="All"
                        FontSize="13" Padding="16,6" CornerRadius="16" />
                <Button x:Name="ChipTripsActive" Text="Activos" Clicked="OnTripsStatusChipClicked" CommandParameter="Active"
                        FontSize="13" Padding="16,6" CornerRadius="16" />
                <Button x:Name="ChipTripsPaused" Text="Pausados" Clicked="OnTripsStatusChipClicked" CommandParameter="Paused"
                        FontSize="13" Padding="16,6" CornerRadius="16" />
            </HorizontalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="Loading"
                           Grid.Row="2"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="0,10"
                           VerticalOptions="Start"
                           HorizontalOptions="Center" />

        <RefreshView x:Name="TripsRefresh"
                     Grid.Row="2"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="TripsList"
                            SelectionMode="None"
                            Footer=" "
                            EmptyView="Aún no has publicado viajes.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:TripListItem">
                    <Border Margin="10,5" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}">
                        <VerticalStackLayout Padding="12" Spacing="6">
                            <Grid ColumnDefinitions="80,*" ColumnSpacing="10">
                                <Image Source="{Binding Thumb}" IsVisible="{Binding Thumb, Converter={StaticResource HasValue}}"
                                       HeightRequest="80" Aspect="AspectFill" />
                                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                    <Label Text="{Binding Trip.Title}" FontSize="17" FontAttributes="Bold" />
                                    <Label Text="PAUSADO" FontSize="12" FontAttributes="Bold" TextColor="#C53030">
                                        <Label.Triggers>
                                            <DataTrigger TargetType="Label" Binding="{Binding IsPaused}" Value="False">
                                                <Setter Property="IsVisible" Value="False" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label Text="{Binding Trip.Destination}" FontSize="14" TextColor="Gray" />
                                    <Label Text="{Binding TransportText}" FontSize="13" TextColor="Gray" />
                                    <Label Text="{Binding Trip.Price, StringFormat='{0:C} por asiento'}" FontSize="13" TextColor="Gray" />
                                </VerticalStackLayout>
                            </Grid>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="Vendidos:" FontSize="13" />
                                <Label Text="{Binding SoldSeats}" FontSize="13" FontAttributes="Bold" />
                                <Label Text="· Disponibles:" FontSize="13" />
                                <Label Text="{Binding AvailableSeats}" FontSize="13" FontAttributes="Bold" />
                                <Label Text="de" FontSize="13" />
                                <Label Text="{Binding Capacity}" FontSize="13" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="6">
                                <Button Text="Ver detalle"
                                        Clicked="OnDetailClicked"
                                        CommandParameter="{Binding Trip}"
                                        HorizontalOptions="Fill"
                                        Margin="0,4,0,0" />
                                <Button Text="Mapa de asientos"
                                        Clicked="OnSeatsClicked"
                                        CommandParameter="{Binding Trip}"
                                        HorizontalOptions="Fill"
                                        Margin="0,4,0,0"
                                        BackgroundColor="#2B6CB0"
                                        TextColor="White" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>