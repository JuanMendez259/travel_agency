<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminDashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Publicar Viaje">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView x:Name="PageScroll">
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label x:Name="FormTitleLabel" Text="Nuevo viaje" FontSize="20" FontAttributes="Bold" />

            <Label Text="Título" />
            <Entry x:Name="TitleEntry" />

            <Label Text="Destino" />
            <Entry x:Name="DestinationEntry" />

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout>
                    <Label Text="Fecha de inicio" />
                    <DatePicker x:Name="StartDatePicker" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Fecha de fin" />
                    <DatePicker x:Name="EndDatePicker" />
                </VerticalStackLayout>
            </Grid>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <VerticalStackLayout>
                    <Label Text="Precio (por asiento)" />
                    <Entry x:Name="PriceEntry" Keyboard="Numeric" />
                    <Label Text="Precio niño (opcional)" FontSize="12" TextColor="Gray" />
                    <Entry x:Name="ChildPriceEntry" Keyboard="Numeric" />
                </VerticalStackLayout>
                <VerticalStackLayout Grid.Column="1">
                    <Label Text="Capacidad total (asientos)" />
                    <Entry x:Name="CapacityEntry" Keyboard="Numeric" />
                </VerticalStackLayout>
            </Grid>

            <Label Text="Descripción" />
            <Editor x:Name="DescriptionEditor" HeightRequest="100" />

            <Label Text="Tipo de transporte" />
            <Picker x:Name="TransportTypePicker" />

            <Button Text="Seleccionar imagen" Clicked="OnPickImageClicked" />
            <Image x:Name="ImagePreview"
                   HeightRequest="140"
                   Aspect="AspectFill"
                   IsVisible="False"
                   Margin="0,8,0,0" />
            <Label x:Name="ImageNameLabel"
                   FontSize="12"
                   TextColor="Gray"
                   IsVisible="False" />

            <Button x:Name="SaveButton" Text="Guardar viaje" Clicked="OnSaveClicked" />
            <Button x:Name="CancelEditButton"
                    Text="Cancelar edición"
                    Clicked="OnCancelEditClicked"
                    IsVisible="False" />

            <BoxView HeightRequest="1" Color="#DDDDDD" Margin="0,20,0,10" />

            <Label Text="Usuarios y roles" FontSize="20" FontAttributes="Bold" />
            <Label Text="Asigna el rol de cada usuario: Administrador, Coordinador o Cliente."
                   FontSize="13"
                   TextColor="Gray" />

            <VerticalStackLayout x:Name="UsersLayout" Spacing="8" Margin="0,6,0,0" />

            <Label x:Name="UsersErrorLabel"
                   Text="No se pudieron cargar los usuarios."
                   TextColor="#C53030"
                   FontSize="13"
                   Margin="0,6,0,0"
                   IsVisible="False" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>