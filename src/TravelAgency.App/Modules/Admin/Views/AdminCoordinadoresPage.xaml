<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminCoordinadoresPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Coordinadores">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label x:Name="FormTitleLabel" Text="Registrar coordinador" FontSize="20" FontAttributes="Bold" />
            <Label Text="Crea la cuenta con rol Coordinador. Al iniciar sesión verá la pestaña de viajes, las solicitudes de cupo y el control de salida."
                   FontSize="13"
                   TextColor="{StaticResource OnSurfaceVariant}" />

            <Label Text="Nombre completo" />
            <Entry x:Name="NameEntry" Placeholder="Ej. María Ramírez" />

            <Label Text="Correo electrónico" />
            <Entry x:Name="EmailEntry" Placeholder="coordinador@travelagency.com" Keyboard="Email" />

            <Label Text="Teléfono / celular" />
            <Entry x:Name="PhoneEntry" Placeholder="+52 55 1234 5678" Keyboard="Telephone" />

            <VerticalStackLayout x:Name="PasswordFieldsLayout" Spacing="10">
                <Label Text="Contraseña temporal" />
                <Entry x:Name="PasswordEntry" Placeholder="Mínimo 6 caracteres" IsPassword="True" />
                <Label Text="Déjala vacía y se generará una automáticamente. Compártela con el coordinador por un canal seguro: no se vuelve a mostrar."
                       FontSize="12"
                       TextColor="{StaticResource OnSurfaceVariant}" />
            </VerticalStackLayout>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                <Button x:Name="GeneratePasswordButton"
                        Text="Generar contraseña"
                        Clicked="OnGeneratePasswordClicked"
                         BackgroundColor="{StaticResource SurfaceContainerHigh}"
                                                 TextColor="{StaticResource OnSurface}" />
                <Button x:Name="RegisterButton"
                        Grid.Column="1"
                        Text="Registrar coordinador"
                        Clicked="OnRegisterClicked"
                                                 BackgroundColor="{StaticResource Primary}" />
            </Grid>

            <Button x:Name="CancelEditButton"
                    Text="Cancelar edición"
                    Clicked="OnCancelEditClicked"
                    IsVisible="False"
                    BackgroundColor="{StaticResource SurfaceContainerHigh}"
                    TextColor="{StaticResource OnSurface}" />

            <Label x:Name="FeedbackLabel"
                   FontSize="13"
                   IsVisible="False" />

            <BoxView HeightRequest="1" Color="{StaticResource OutlineVariant}" Margin="0,20,0,10" />

            <Label Text="Coordinadores registrados" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="CountLabel" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />

            <VerticalStackLayout x:Name="CoordinatorsLayout" Spacing="8" Margin="0,6,0,0" />

            <Label x:Name="EmptyLabel"
                   Text="Todavía no hay coordinadores registrados."
                   FontSize="13"
                   TextColor="{StaticResource OnSurfaceVariant}"
                   IsVisible="False" />

            <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
