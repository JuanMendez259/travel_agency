<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminCoordinadoresPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    Title="Coordinadores"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Admin · Coordinadores"
            PageTitle="Coordinadores"
            ShowBack="False"
            ShowLogout="True"
            LogoutRequested="OnLogoutClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,32" Spacing="16">

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="FormTitleLabel"
                               Text="Registrar coordinador"
                               Style="{StaticResource AdminCardTitle}"
                               FontSize="18" />
                        <Label Text="Crea la cuenta con rol Coordinador. Al iniciar sesión verá la pestaña de viajes, las solicitudes de cupo y el control de salida."
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}" />

                        <Label Text="Nombre completo" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Entry x:Name="NameEntry" Placeholder="Ej. María Ramírez" HeightRequest="48"
                               BackgroundColor="{StaticResource SurfaceContainerLow}"
                               TextColor="{StaticResource OnSurface}"
                               PlaceholderColor="{StaticResource Outline}" />

                        <Label Text="Correo electrónico" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Entry x:Name="EmailEntry" Placeholder="coordinador@travelagency.com" Keyboard="Email"
                               HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />

                        <Label Text="Teléfono / celular" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Entry x:Name="PhoneEntry" Placeholder="+52 55 1234 5678" Keyboard="Telephone"
                               HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />

                        <VerticalStackLayout x:Name="PasswordFieldsLayout" Spacing="8">
                            <Label Text="Contraseña temporal" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                            <Entry x:Name="PasswordEntry" Placeholder="Mínimo 6 caracteres" IsPassword="True"
                                   HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                                   TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />
                            <Label Text="Déjala vacía y se generará automáticamente. Compártela con el coordinador por un canal seguro: no se vuelve a mostrar."
                                   FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button x:Name="GeneratePasswordButton"
                                    Text="Generar contraseña"
                                    Style="{StaticResource AdminTonalButton}"
                                    FontSize="13"
                                    Clicked="OnGeneratePasswordClicked" />
                            <Button x:Name="RegisterButton"
                                    Grid.Column="1"
                                    Text="Registrar coordinador"
                                    Clicked="OnRegisterClicked"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource OnPrimary}"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="16"
                                    MinimumHeightRequest="44"
                                    FontSize="13" />
                        </Grid>

                        <Button x:Name="CancelEditButton"
                                Text="Cancelar edición"
                                Clicked="OnCancelEditClicked"
                                IsVisible="False"
                                Style="{StaticResource AdminTonalButton}" />

                        <Label x:Name="FeedbackLabel" FontSize="13" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Coordinadores registrados" Style="{StaticResource AdminCardTitle}" />
                            <Label x:Name="CountLabel"
                                   Grid.Column="1"
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="CoordinatorsLayout" Spacing="10" />

                        <Label x:Name="EmptyLabel"
                               Text="Todavía no hay coordinadores registrados."
                               FontSize="13"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center"
                               Margin="0,12"
                               IsVisible="False" />

                        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
