<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminPayoutsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    Title="Reembolsos"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Admin · Reembolsos"
            PageTitle="Reembolsos"
            ShowBack="False"
            ShowLogout="True"
            LogoutRequested="OnLogoutClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,32" Spacing="16">

                <Border Style="{StaticResource AdminCard}">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border WidthRequest="44"
                                HeightRequest="44"
                                Padding="0"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 14"
                                BackgroundColor="{StaticResource SurfaceContainerLow}">
                            <Label Text="💸" FontSize="20" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Solicitudes de retiro"
                                   Style="{StaticResource AdminCardTitle}" />
                            <Label Text="Marca como pagado cuando entregues el dinero o rechaza para liberar el saldo."
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Solicitudes" Style="{StaticResource AdminCardTitle}" />
                            <Label x:Name="CountLabel"
                                   Grid.Column="1"
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="PayoutsLayout" Spacing="10" />

                        <Label x:Name="EmptyLabel"
                               Text="Todavía no hay solicitudes de reembolso."
                               FontSize="13"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center"
                               Margin="0,12"
                               IsVisible="False" />

                        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />

                        <Label x:Name="ErrorLabel"
                               FontSize="13"
                               TextColor="{StaticResource Error}"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
