<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripOptionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    Title="Opciones del viaje"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Gestión de viajes"
            PageTitle="Opciones del viaje"
            ShowBack="True"
            ShowLogout="True"
            LogoutRequested="OnLogoutClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,32" Spacing="16">

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label x:Name="TripNameLabel"
                               Style="{StaticResource AdminCardTitle}"
                               FontSize="19" />
                        <Label x:Name="AvailabilityLabel"
                               FontSize="13"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label x:Name="HotelLabel"
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Label x:Name="FormTitleLabel"
                               Text="Nueva opción"
                               Style="{StaticResource AdminCardTitle}"
                               FontSize="18" />
                        <Label Text="Un paquete o boleto con su propio precio y beneficios. Los clientes eligen una o varias de estas opciones al reservar."
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}" />

                        <Label Text="Nombre de la opción" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Entry x:Name="OptionNameEntry" Placeholder="Ej. Sencillo, VIP, Todo incluido"
                               HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                               TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Precio adulto (MXN)" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Entry x:Name="PriceAdultEntry" Placeholder="Ej. 2500" Keyboard="Numeric"
                                       HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                                       TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label Text="Precio niño (opcional)" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                                <Entry x:Name="PriceChildEntry" Placeholder="Vacío = paga como adulto" Keyboard="Numeric"
                                       HeightRequest="48" BackgroundColor="{StaticResource SurfaceContainerLow}"
                                       TextColor="{StaticResource OnSurface}" PlaceholderColor="{StaticResource Outline}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Label Text="Beneficios" FontSize="13" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Label Text="Escribe uno por línea (ej. Transporte, Desayuno, Guía)."
                               FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                        <Editor x:Name="BenefitsEditor"
                                Placeholder="Transporte redondo&#10;Desayuno incluido&#10;Guía certificado"
                                AutoSize="TextChanges"
                                HeightRequest="110"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                TextColor="{StaticResource OnSurface}"
                                PlaceholderColor="{StaticResource Outline}" />

                        <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                            <VerticalStackLayout Grid.Column="0" Spacing="1" VerticalOptions="Center">
                                <Label Text="Opción activa" FontSize="14" FontAttributes="Bold" />
                                <Label Text="Si la desactivas, deja de ofrecerse a nuevos clientes."
                                       FontSize="12" TextColor="{StaticResource OnSurfaceVariant}" />
                            </VerticalStackLayout>
                            <Switch x:Name="ActiveSwitch" Grid.Column="1" IsToggled="True" VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,4,0,0">
                            <Button x:Name="SaveButton"
                                    Text="Guardar opción"
                                    Clicked="OnSaveClicked"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource OnPrimary}"
                                    FontFamily="OpenSansSemibold"
                                    CornerRadius="16"
                                    MinimumHeightRequest="44" />
                            <Button x:Name="CancelEditButton"
                                    Grid.Column="1"
                                    Text="Cancelar edición"
                                    Clicked="OnCancelEditClicked"
                                    IsVisible="False"
                                    Style="{StaticResource AdminTonalButton}" />
                        </Grid>

                        <Label x:Name="FeedbackLabel" FontSize="13" IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Label Text="Opciones registradas" Style="{StaticResource AdminCardTitle}" />
                            <Label x:Name="CountLabel"
                                   Grid.Column="1"
                                   FontSize="12"
                                   TextColor="{StaticResource OnSurfaceVariant}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <VerticalStackLayout x:Name="OptionsLayout" Spacing="10" />

                        <Label x:Name="EmptyLabel"
                               Text="Este viaje todavía no tiene opciones."
                               FontSize="13"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalTextAlignment="Center"
                               Margin="0,12"
                               IsVisible="False" />

                        <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
