<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminBookingQrPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    Title="Código QR"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Check-in"
            PageTitle="Código QR"
            ShowBack="True"
            ShowLogout="False"
            BackRequested="OnBackClicked" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,32" Spacing="16">

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="12">
                        <Border StrokeShape="RoundRectangle 20"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource SurfaceContainerLow}"
                                Padding="16"
                                HorizontalOptions="Center">
                            <Image x:Name="QrImage"
                                   HeightRequest="260"
                                   WidthRequest="260"
                                   HorizontalOptions="Center" />
                        </Border>

                        <Label x:Name="PassengerLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource OnSurface}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                        <Label x:Name="TripLabel"
                               FontSize="13"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               HorizontalOptions="Center"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource AdminCard}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Estado del boleto" Style="{StaticResource AdminCardTitle}" />
                        <Label x:Name="SeatsLabel"
                               FontSize="14"
                               TextColor="{StaticResource OnSurfaceVariant}" />
                        <Label x:Name="StateLabel"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource Primary}" />
                        <Label x:Name="CheckedInAtLabel"
                               FontSize="12"
                               TextColor="{StaticResource OnSurfaceVariant}"
                               IsVisible="False" />
                    </VerticalStackLayout>
                </Border>

                <Button x:Name="BoardButton"
                        Text="✅ Marcar como abordado"
                        Clicked="OnBoardClicked"
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="{StaticResource OnPrimary}"
                        FontFamily="OpenSansSemibold"
                        CornerRadius="16"
                        MinimumHeightRequest="48" />

                <Label Text="Cada código registra un pasajero. Si el boleto ya fue abordado, se mostrará el aviso correspondiente."
                       FontSize="12"
                       TextColor="{StaticResource OnSurfaceVariant}"
                       HorizontalTextAlignment="Center" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
