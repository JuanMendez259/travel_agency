<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminBookingDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    Title="Detalle de Reserva">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label x:Name="TripLabel" FontSize="20" FontAttributes="Bold" />
            <Label x:Name="ClientLabel" FontSize="15" TextColor="{StaticResource OnSurfaceVariant}" />
            <Label x:Name="InfoLabel" FontSize="14" />
            <Label x:Name="StatusLabel" FontSize="15" FontAttributes="Bold" />
            <Label x:Name="BalanceLabel" FontSize="15" FontAttributes="Bold" TextColor="#1976D2" />

            <Border x:Name="SpecialNeedsSection" IsVisible="False" StrokeShape="RoundRectangle 10"
                    StrokeThickness="0" BackgroundColor="#FFF3CD" Padding="12" Margin="0,4">
                <VerticalStackLayout Spacing="2">
                    <Label Text="🧩 Necesidades especiales" FontSize="14" FontAttributes="Bold" TextColor="#7A5C00" />
                    <Label x:Name="SpecialNeedsLabel" FontSize="14" TextColor="#7A5C00" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="PaymentButton" Text="Registrar pago" Clicked="OnRegisterPaymentClicked" />
            <Button x:Name="CancelButton" Text="Cancelar reserva" Clicked="OnCancelClicked" BackgroundColor="#B00020" />

            <Button Text="Historial de cambios" Clicked="OnAuditClicked" Margin="0,5,0,0" />

            <Button Text="Volver a reservas" Clicked="OnBackClicked" Margin="0,5,0,0" />

            <Label x:Name="ItemsHeader" Text="Detalle por opciones" FontSize="18" FontAttributes="Bold" Margin="0,15,0,0" IsVisible="False" />
            <VerticalStackLayout x:Name="ItemsLayout" Spacing="4" />

            <Label x:Name="PassengersHeader" Text="Acompañantes" FontSize="18" FontAttributes="Bold" Margin="0,15,0,0" IsVisible="False" />
            <VerticalStackLayout x:Name="PassengersLayout" Spacing="4" />
            <Label Text="Pagos registrados" FontSize="18" FontAttributes="Bold" Margin="0,15,0,0" />
            <CollectionView x:Name="PaymentsList" SelectionMode="None" Footer=" ">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Payment">
                        <Border Margin="0,4" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}">
                            <VerticalStackLayout Padding="12" Spacing="2">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding PaymentDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="{StaticResource OnSurfaceVariant}" />
                                    <Label Text="·" TextColor="{StaticResource OnSurfaceVariant}" />
                                    <Label Text="{Binding Method}" TextColor="{StaticResource OnSurfaceVariant}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Amount, StringFormat='{0:C}'}" FontAttributes="Bold" />
                                    <Label Text="·" />
                                    <Label Text="{Binding Status}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>