<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminTripMapPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Mapa e itinerario">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="8">
        <Label x:Name="TripLabel"
               Grid.Row="0"
               FontSize="16"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               Margin="4,0,0,6" />

        <WebView x:Name="MapView" Grid.Row="1" Navigating="OnWebNavigating" />

        <Grid Grid.Row="2" ColumnDefinitions="*,*,*" ColumnSpacing="8" Padding="0,8,0,0">
            <Button Text="Marcar origen"
                    Clicked="OnOriginModeClicked"
                    BackgroundColor="#00A85A"
                    TextColor="White" />
            <Button Grid.Column="1"
                    Text="Agregar punto"
                    Clicked="OnPoiModeClicked"
                    BackgroundColor="#1E88E5"
                    TextColor="White" />
            <Button Grid.Column="2"
                    Text="Marcar destino"
                    Clicked="OnDestModeClicked"
                    BackgroundColor="#C62828"
                    TextColor="White" />
        </Grid>
    </Grid>
</ContentPage>