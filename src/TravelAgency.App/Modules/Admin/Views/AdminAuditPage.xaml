<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminAuditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:TravelAgency.App.Modules.Admin.ViewModels"
    Title="Historial">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="12">

            <Label x:Name="AuditTitle" FontSize="20" FontAttributes="Bold" />

            <VerticalStackLayout x:Name="AuditList" Spacing="10">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="vm:AuditItem">
                        <Border StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#F2F4F7, Dark=#2C2C2C}">
                            <VerticalStackLayout Padding="12" Spacing="4">
                                <Label Text="{Binding Summary}" FontAttributes="Bold" />
                                <Label Text="{Binding WhoWhen}" FontSize="12" TextColor="Gray" />
                                <Label Text="{Binding DiffText}"
                                       FontSize="12"
                                       Margin="0,4,0,0"
                                       IsVisible="{Binding HasDiff}" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label x:Name="EmptyLabel"
                   Text="Sin registros de cambios."
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,30,0,0"
                   IsVisible="False" />

            <Button Text="Volver" Clicked="OnBackClicked" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>