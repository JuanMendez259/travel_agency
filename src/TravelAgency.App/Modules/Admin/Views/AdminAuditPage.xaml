<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminAuditPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:adminControls="clr-namespace:TravelAgency.App.Controls.Admin"
    xmlns:vm="clr-namespace:TravelAgency.App.Modules.Admin.ViewModels"
    Title="Historial"
    Shell.NavBarIsVisible="False"
    SafeAreaEdges="Container"
    BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*">
        <adminControls:AdminPageHeader
            Grid.Row="0"
            Eyebrow="Historial"
            PageTitle="Historial de cambios"
            ShowBack="True"
            ShowLogout="True"
            BackRequested="OnBackClicked"
            LogoutRequested="OnLogoutClicked" />

        <RefreshView x:Name="AuditRefresh" Grid.Row="1" Refreshing="OnRefreshing">
            <ScrollView>
                <VerticalStackLayout Padding="20,4,20,32" Spacing="12">

                    <Label x:Name="AuditTitle"
                           Style="{StaticResource AdminCardTitle}"
                           FontSize="18" />

                    <VerticalStackLayout x:Name="AuditList" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:AuditItem">
                                <Border Style="{StaticResource AdminCard}" Padding="14">
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Summary}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="{StaticResource OnSurface}" />
                                        <Label Text="{Binding WhoWhen}"
                                               FontSize="12"
                                               TextColor="{StaticResource OnSurfaceVariant}" />
                                        <Label Text="{Binding DiffText}"
                                               FontSize="12"
                                               FontFamily="OpenSansRegular"
                                               TextColor="{StaticResource OnSurfaceVariant}"
                                               Margin="0,4,0,0"
                                               IsVisible="{Binding HasDiff}" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <Label x:Name="EmptyLabel"
                           Text="Sin registros de cambios."
                           FontSize="14"
                           TextColor="{StaticResource OnSurfaceVariant}"
                           HorizontalOptions="Center"
                           Margin="0,30,0,0"
                           IsVisible="False" />

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>
