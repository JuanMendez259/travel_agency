<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Admin.Views.AdminCheckinPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Check-in / Salida">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Label x:Name="TripTitleLabel" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="TripMetaLabel" FontSize="14" TextColor="Gray" />

            <Border x:Name="StatusBanner"
                    StrokeThickness="0"
                    Padding="16"
                    Margin="0,6,0,0">
                <VerticalStackLayout Spacing="4">
                    <Label x:Name="StatusLabel" FontSize="17" FontAttributes="Bold" TextColor="White" />
                    <Label x:Name="ProgressLabel" FontSize="14" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Button x:Name="OpenCheckinButton"
                    Text="Abrir check-in"
                    Clicked="OnOpenCheckinClicked"
                    BackgroundColor="#2B6CB0" TextColor="White" />

            <Button x:Name="CloseCheckinButton"
                    Text="Cerrar check-in"
                    Clicked="OnCloseCheckinClicked"
                    IsVisible="False"
                    BackgroundColor="#B7791F" TextColor="White" />

            <Button x:Name="CompleteButton"
                    Text="Marcar salida completada"
                    Clicked="OnCompleteClicked"
                    BackgroundColor="#2F855A" TextColor="White" />

            <Button x:Name="ReopenButton"
                    Text="Reabrir salida"
                    Clicked="OnReopenClicked"
                    IsVisible="False"
                    BackgroundColor="#2B6CB0" TextColor="White" />

            <Label Text="Pasajeros" FontSize="16" FontAttributes="Bold" Margin="0,15,0,0" />
            <VerticalStackLayout x:Name="PassengersLayout" Spacing="6" />

            <Label x:Name="NoPassengersLabel"
                   Text="Este viaje no tiene reservas para controlar."
                   TextColor="Gray"
                   IsVisible="False" />

            <Button Text="Volver" Clicked="OnBackClicked" Margin="0,15,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>