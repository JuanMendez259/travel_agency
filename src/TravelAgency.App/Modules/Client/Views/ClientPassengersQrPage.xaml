<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientPassengersQrPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="QR de Acompañantes">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label x:Name="TripLabel" FontSize="14" TextColor="Gray" HorizontalOptions="Center" />
            <Label x:Name="NoPassengersLabel"
                   Text="Esta reserva no tiene pasajeros adicionales."
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   IsVisible="False" />

            <VerticalStackLayout x:Name="PassengersLayout" Spacing="16" />

            <Button Text="Volver" Clicked="OnBackClicked" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>