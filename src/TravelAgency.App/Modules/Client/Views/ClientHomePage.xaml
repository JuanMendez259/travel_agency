<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientHomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    xmlns:viewmodels="clr-namespace:TravelAgency.App.ViewModels"
    xmlns:conv="clr-namespace:TravelAgency.App.Converters"
    Title="Explorar Viajes">

    <ContentPage.Resources>
        <conv:HasValueConverter x:Key="HasValue" />
        <conv:TransportTypeConverter x:Key="TransportType" />
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="★ Favoritos" Clicked="OnFavoritesClicked" />
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 10"
                Stroke="{StaticResource Gray200}"
                BackgroundColor="{StaticResource Gray100}"
                Padding="12,0"
                Margin="12,8,12,4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="🔍" FontSize="15" VerticalOptions="Center" />
                <Entry x:Name="SearchEntry"
                       Grid.Column="1"
                       Placeholder="Buscar por destino o viaje"
                       BackgroundColor="Transparent"
                       TextColor="{StaticResource Gray950}"
                       PlaceholderColor="{StaticResource Gray500}"
                       FontSize="14"
                       HeightRequest="44"
                       TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="12,8,0,0"
                    IsVisible="False"
                    x:Name="CategoryFiltersScroll">
            <HorizontalStackLayout x:Name="CategoryFiltersLayout" Spacing="8" Padding="0,0,12,0" />
        </ScrollView>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="12,8,12,0" ColumnSpacing="8">
            <Label Text="Próximas Salidas Locales"
                   FontSize="16"
                   FontAttributes="Bold"
                   VerticalOptions="Center" />
            <Label x:Name="TripsCountLabel"
                   Grid.Column="1"
                   FontSize="13"
                   TextColor="Gray"
                   VerticalOptions="Center" />
        </Grid>

        <ActivityIndicator x:Name="Loading"
                           Grid.Row="3"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="0,10"
                           HorizontalOptions="Center" />

        <RefreshView x:Name="TripsRefresh"
                     Grid.Row="4"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="TripsList"
                            SelectionMode="None"
                            Footer=" "
                            EmptyView="No hay viajes disponibles.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:TripListItem">
                    <Border Margin="10,5" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}">
                        <VerticalStackLayout Spacing="4">
                            <Image Source="{Binding Thumb}" IsVisible="{Binding Thumb, Converter={StaticResource HasValue}}"
                                   HeightRequest="140" Aspect="AspectFill" />
                            <VerticalStackLayout Padding="12" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Trip.Title}" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="{Binding HeartText}"
                                            TextColor="{Binding HeartColor}"
                                            FontSize="24"
                                            Padding="8"
                                            BackgroundColor="Transparent"
                                            Clicked="OnFavoriteClicked"
                                            CommandParameter="{Binding}"
                                            VerticalOptions="Center" />
                                </Grid>
                                <Label Text="{Binding Trip.Destination}" FontSize="14" TextColor="Gray" />
                                <Label Text="{Binding CategoryText}" FontSize="13" TextColor="#2B6CB0" IsVisible="{Binding HasCategory}" />
                                <Label Text="{Binding DescriptionText}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       IsVisible="{Binding HasDescription}" />
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Trip.StartDate, StringFormat='{0:dd/MM/yyyy}'}" />
                                    <Label Text="al" />
                                    <Label Text="{Binding Trip.EndDate, StringFormat='{0:dd/MM/yyyy}'}" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Trip.Price, StringFormat='{0:C}'}" FontAttributes="Bold" />
                                    <Label Text="·" />
                                    <Label Text="{Binding AvailabilityText}" TextColor="Gray" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Trip.TransportType, Converter={StaticResource TransportType}}" FontSize="12" TextColor="Gray" />
                                <Button Text="{Binding BookButtonText}"
                                        Clicked="OnBookClicked"
                                        CommandParameter="{Binding Trip}"
                                        Margin="0,8,0,0" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>