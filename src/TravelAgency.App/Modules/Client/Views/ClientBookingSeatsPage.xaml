<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientBookingSeatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Elige tus asientos">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12">
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label x:Name="TripLabel" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label x:Name="SummaryLabel" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0,8,0,0">
            <Label Text="Pasajeros" FontSize="14" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="PassengersLayout" Spacing="6" />
            <Label Text="Toca un asiento libre y elige a quién asignarlo."
                   FontSize="12" TextColor="Gray" />
            <HorizontalStackLayout Spacing="14" Margin="0,4,0,0">
                <HorizontalStackLayout Spacing="4">
                    <BoxView CornerRadius="4" WidthRequest="14" HeightRequest="14" Color="#D9D9D9" />
                    <Label Text="Libre" FontSize="11" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <BoxView CornerRadius="4" WidthRequest="14" HeightRequest="14" Color="#0A5AAE" />
                    <Label Text="Elegido" FontSize="11" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <BoxView CornerRadius="4" WidthRequest="14" HeightRequest="14" Color="#DBB92A" />
                    <Label Text="Ocupado" FontSize="11" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="2" Margin="0,8,0,0">
            <VerticalStackLayout Spacing="12">
                <Border Stroke="#CCCCCC" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🚌" FontSize="22" HorizontalOptions="End" Margin="0,0,4,0" />
                        <VerticalStackLayout x:Name="RowsContainer" Spacing="10" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Button x:Name="ConfirmButton"
                Grid.Row="3"
                Text="Confirmar reserva"
                Clicked="OnConfirmClicked"
                IsEnabled="False"
                Margin="0,10,0,0"
                BackgroundColor="#2B6CB0"
                TextColor="White" />
    </Grid>
</ContentPage>
