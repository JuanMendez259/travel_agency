<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientBookingSeatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Elige tus asientos">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="ColorSelected">#0A5AAE</Color>
            <Color x:Key="ColorOnDark">#1A2433</Color>
            <Color x:Key="ColorGray">#5F6B7A</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Padding="12">
        <VerticalStackLayout Grid.Row="0" Spacing="2">
            <Label x:Name="TripLabel" FontSize="17" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label x:Name="SummaryLabel" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1" Spacing="8" Margin="0,8,0,0">
            <Label Text="Pasajeros" FontSize="14" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="PassengersLayout" Spacing="6" />
            <Label Text="Toca un asiento libre y elige a quién asignarlo."
                   FontSize="12" TextColor="Gray" />
            <HorizontalStackLayout Spacing="14" Margin="0,4,0,0">
                <HorizontalStackLayout Spacing="4">
                    <BoxView CornerRadius="4" WidthRequest="14" HeightRequest="14" Color="#D9D9D9" />
                    <Label Text="Libre" FontSize="11" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <BoxView CornerRadius="4" WidthRequest="14" HeightRequest="14" Color="#0A5AAE" />
                    <Label Text="Elegido" FontSize="11" />
                </HorizontalStackLayout>
                <HorizontalStackLayout Spacing="4">
                    <BoxView CornerRadius="4" WidthRequest="14" HeightRequest="14" Color="#DBB92A" />
                    <Label Text="Ocupado" FontSize="11" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </VerticalStackLayout>

        <ScrollView Grid.Row="2" Margin="0,8,0,0">
            <VerticalStackLayout Spacing="12">
                <Border Stroke="#CCCCCC" StrokeShape="RoundRectangle 16" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="🚌" FontSize="22" HorizontalOptions="End" Margin="0,0,4,0" />
                        <VerticalStackLayout x:Name="RowsContainer" Spacing="10" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="3"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 14"
                BackgroundColor="#F1F5FB"
                Padding="14"
                Margin="0,10,0,0">
            <VerticalStackLayout Spacing="6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                        <Label Text="TOTAL A PAGAR" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource ColorGray}" />
                        <Label x:Name="TotalLabel" Text="—"
                               FontSize="24" FontAttributes="Bold"
                               TextColor="{StaticResource ColorSelected}" />
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="2"
                                         HorizontalOptions="End" VerticalOptions="Center">
                        <Label Text="ASIENTOS ELEGIDOS" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource ColorGray}"
                               HorizontalTextAlignment="End" />
                        <Label x:Name="SelectedSeatsLabel" Text="Ninguno"
                               FontSize="14" FontAttributes="Bold"
                               TextColor="{StaticResource ColorOnDark}"
                               HorizontalTextAlignment="End"
                               MaxLines="2" LineBreakMode="TailTruncation" />
                    </VerticalStackLayout>
                </Grid>
                <Label x:Name="FareBreakdownLabel" Text="—"
                       FontSize="11" TextColor="{StaticResource ColorGray}" />
            </VerticalStackLayout>
        </Border>

        <Button x:Name="ConfirmButton"
                Grid.Row="4"
                Text="Confirmar reserva"
                Clicked="OnConfirmClicked"
                IsEnabled="False"
                Margin="0,10,0,0"
                BackgroundColor="#2B6CB0"
                TextColor="White" />
    </Grid>
</ContentPage>
