<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientBookingSeatsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Elige tus asientos">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="ColorPrimary">#003B1B</Color>
            <Color x:Key="ColorSecondary">#006C49</Color>
            <Color x:Key="ColorPrimaryFixedDim">#96D5A3</Color>
            <Color x:Key="ColorSurfaceContainerLowest">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceContainerLow">#F2F3FF</Color>
            <Color x:Key="ColorSurfaceContainer">#EAEDFF</Color>
            <Color x:Key="ColorSurfaceContainerHigh">#E2E7FF</Color>
            <Color x:Key="ColorSurfaceContainerHighest">#DAE2FD</Color>
            <Color x:Key="ColorSurfaceDim">#D2D9F4</Color>
            <Color x:Key="ColorOnSurface">#131B2E</Color>
            <Color x:Key="ColorOnSurfaceVariant">#404941</Color>
            <Color x:Key="ColorOutline">#717970</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ============ TARJETA DEL VIAJE ============ -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{StaticResource ColorPrimary}"
                Padding="16"
                Margin="20,12,20,0">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.16" Radius="12" Offset="0,4" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="4">
                <Label x:Name="TripLabel"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="White" />
                <HorizontalStackLayout Spacing="6">
                    <Label Text="💺" FontSize="13" VerticalOptions="Center" />
                    <Label x:Name="SummaryLabel"
                           FontSize="12"
                           TextColor="{StaticResource ColorPrimaryFixedDim}"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="0">

                <!-- ============ PASAJEROS Y BOLETOS ============ -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource ColorSurfaceContainerLowest}"
                        Padding="16"
                        Margin="20,12,20,0">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="10" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="👥" FontSize="18" VerticalOptions="Center" />
                                <Label Text="Pasajeros y Boletos"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorOnSurface}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Border Grid.Column="1"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{StaticResource ColorSurfaceContainerHigh}"
                                    Padding="9,3"
                                    VerticalOptions="Center">
                                <Label x:Name="AssignedCountLabel"
                                       Text="0 / 0 asignados"
                                       FontSize="11" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorOnSurfaceVariant}" />
                            </Border>
                        </Grid>

                        <Label x:Name="SeatGateHintLabel"
                               Text="Completa el nombre y la edad de cada pasajero para poder elegir asientos."
                               FontSize="12"
                               TextColor="{StaticResource ColorOnSurfaceVariant}" />

                        <VerticalStackLayout x:Name="PassengersLayout" Spacing="12" />

                        <!-- Leyenda -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                                Padding="12,10">
                            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                <HorizontalStackLayout Spacing="6">
                                    <Border WidthRequest="20" HeightRequest="20"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{StaticResource ColorSurfaceContainerHighest}">
                                        <Label Text="1" FontSize="10"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Libre" FontSize="11" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                    <Border WidthRequest="20" HeightRequest="20"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            BackgroundColor="{StaticResource ColorSecondary}">
                                        <Label Text="✓" FontSize="12" TextColor="White"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Tu elección" FontSize="11" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorSecondary}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Grid.Column="2" Spacing="6">
                                    <Border WidthRequest="20" HeightRequest="20"
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 6"
                                            Opacity="0.75"
                                            BackgroundColor="{StaticResource ColorSurfaceDim}">
                                        <Label Text="✕" FontSize="10"
                                               TextColor="{StaticResource ColorOutline}"
                                               HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Label Text="Ocupado" FontSize="11"
                                           TextColor="{StaticResource ColorOutline}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- ============ MAPA DE ASIENTOS ============ -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 16"
                        BackgroundColor="{StaticResource ColorSurfaceContainerLowest}"
                        Padding="16"
                        Margin="20,12,20,16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="10" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto">
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label Text="🚌" FontSize="18" VerticalOptions="Center" />
                                <Label Text="Distribución de Asientos"
                                       FontSize="16" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorOnSurface}"
                                       VerticalOptions="Center" />
                            </HorizontalStackLayout>
                            <Label Grid.Column="1"
                                   Text="Planta única"
                                   FontSize="11" FontAttributes="Bold"
                                   TextColor="{StaticResource ColorSecondary}"
                                   VerticalOptions="Center" />
                        </Grid>

                        <!-- Silueta del autobús -->
                        <Border StrokeThickness="0"
                                StrokeShape="RoundRectangle 26"
                                BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                                Padding="12"
                                HorizontalOptions="Center"
                                WidthRequest="360">
                            <VerticalStackLayout Spacing="10">

                                <!-- Cabina -->
                                <Border StrokeThickness="0"
                                        StrokeShape="RoundRectangle 18"
                                        BackgroundColor="{StaticResource ColorSurfaceContainer}"
                                        Padding="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Border StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                BackgroundColor="{StaticResource ColorSurfaceContainerLowest}"
                                                Padding="10,4"
                                                HorizontalOptions="Start">
                                            <HorizontalStackLayout Spacing="6">
                                                <Label Text="🏎️" FontSize="15" VerticalOptions="Center" />
                                                <Label Text="Cabina Conductor"
                                                       FontSize="11" FontAttributes="Bold"
                                                       TextColor="{StaticResource ColorOnSurface}"
                                                       VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                        <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                                            <Label Text="Puerta frontal" FontSize="11" FontAttributes="Bold"
                                                   TextColor="{StaticResource ColorOnSurfaceVariant}"
                                                   VerticalOptions="Center" />
                                            <Label Text="🔒" FontSize="13" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>

                                <!-- Indicador de pasillo -->
                                <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="6">
                                    <Label Text="Fila Izq." FontSize="10" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorOutline}"
                                           HorizontalTextAlignment="End" />
                                    <Label Grid.Column="1" Text="Pasillo" FontSize="10" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorSecondary}" />
                                    <Label Grid.Column="2" Text="Fila Der." FontSize="10" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorOutline}" />
                                </Grid>

                                <VerticalStackLayout x:Name="RowsContainer" Spacing="10" />

                                <!-- Parte trasera -->
                                <Grid ColumnDefinitions="*,Auto" Margin="4,2,4,0">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="🧳" FontSize="14" VerticalOptions="Center" />
                                        <Label Text="Maletero bajo piso" FontSize="11"
                                               TextColor="{StaticResource ColorOutline}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6">
                                        <Label Text="🚻" FontSize="14" VerticalOptions="Center" />
                                        <Label Text="Sanitario" FontSize="11"
                                               TextColor="{StaticResource ColorOutline}"
                                               VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ BARRA DE RESERVA ============ -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 16"
                BackgroundColor="{StaticResource ColorSurfaceContainerLowest}"
                Padding="16"
                Margin="20,0,20,12">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.14" Radius="16" Offset="0,-3" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <VerticalStackLayout Spacing="1">
                        <Label Text="Total" FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource ColorOnSurfaceVariant}" />
                        <HorizontalStackLayout Spacing="4">
                            <Label x:Name="TotalLabel" Text="—"
                                   FontSize="22" FontAttributes="Bold"
                                   TextColor="{StaticResource ColorPrimary}" />
                            <Label Text="MXN" FontSize="12"
                                   TextColor="{StaticResource ColorOnSurfaceVariant}"
                                   VerticalOptions="End" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="1"
                                         HorizontalOptions="End" VerticalOptions="Center">
                        <Label x:Name="SelectedSeatsLabel"
                               Text="Asientos: —"
                               FontSize="11" FontAttributes="Bold"
                               TextColor="{StaticResource ColorSecondary}"
                               HorizontalTextAlignment="End"
                               MaxLines="2" LineBreakMode="TailTruncation" />
                        <Label x:Name="RemainingLabel"
                               Text="Falta asignar 1 asiento"
                               FontSize="12"
                               TextColor="{StaticResource ColorOutline}"
                               HorizontalTextAlignment="End" />
                    </VerticalStackLayout>
                </Grid>

                <Label x:Name="FareBreakdownLabel" Text="—"
                       FontSize="11"
                       TextColor="{StaticResource ColorOnSurfaceVariant}" />

                <Button x:Name="ConfirmButton"
                        Text="Elige los asientos"
                        Clicked="OnConfirmClicked"
                        IsEnabled="False"
                        HeightRequest="52"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        BackgroundColor="{StaticResource ColorPrimary}"
                        TextColor="White" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>