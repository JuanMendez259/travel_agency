<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientRateTripPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Califica el viaje">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="DestinationLabel" FontSize="16" TextColor="Gray" />

            <Label Text="¿Cómo fue tu experiencia?" FontSize="16" FontAttributes="Bold" Margin="0,15,0,0" />

            <HorizontalStackLayout x:Name="StarsLayout" Spacing="8" HorizontalOptions="Center">
                <Button Text="★" FontSize="32" WidthRequest="56" HeightRequest="56" Padding="0"
                        Clicked="OnStarClicked" BackgroundColor="#2D3748" TextColor="White" />
                <Button Text="★" FontSize="32" WidthRequest="56" HeightRequest="56" Padding="0"
                        Clicked="OnStarClicked" BackgroundColor="#2D3748" TextColor="White" />
                <Button Text="★" FontSize="32" WidthRequest="56" HeightRequest="56" Padding="0"
                        Clicked="OnStarClicked" BackgroundColor="#2D3748" TextColor="White" />
                <Button Text="★" FontSize="32" WidthRequest="56" HeightRequest="56" Padding="0"
                        Clicked="OnStarClicked" BackgroundColor="#2D3748" TextColor="White" />
                <Button Text="★" FontSize="32" WidthRequest="56" HeightRequest="56" Padding="0"
                        Clicked="OnStarClicked" BackgroundColor="#2D3748" TextColor="White" />
            </HorizontalStackLayout>
            <Label x:Name="RatingLabel" Text="Selecciona de 1 a 5 estrellas" FontSize="13" TextColor="Gray" HorizontalOptions="Center" />

            <Editor x:Name="CommentEditor"
                    Placeholder="Cuéntanos cómo fue (opcional)"
                    HeightRequest="120"
                    AutoSize="TextChanges" />

            <Button x:Name="SaveButton" Text="Guardar calificación"
                    Clicked="OnSaveClicked"
                    Margin="0,10,0,0"
                    BackgroundColor="#2F855A" TextColor="White" />

            <Button Text="Volver" Clicked="OnBackClicked" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>