<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientMyTripsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    Title="Mis Viajes">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">
        <ActivityIndicator x:Name="Loading"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="0,10"
                           HorizontalOptions="Center" />

        <VerticalStackLayout x:Name="NotificationsSection"
                             Grid.Row="1"
                             IsVisible="False"
                             Margin="10,5">
            <Label Text="Avisos" FontSize="16" FontAttributes="Bold" Margin="0,0,0,4" />
            <CollectionView x:Name="NotificationsList"
                            SelectionMode="None"
                            Footer=" ">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:UserNotification">
                        <Border Margin="0,3" StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light=#FFE9C7, Dark=#5A4A2A}">
                            <VerticalStackLayout Padding="10" Spacing="2">
                                <Label Text="{Binding CreatedAt, StringFormat='{0:dd/MM/yyyy HH:mm}'}"
                                       FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding Message}" FontSize="13" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </VerticalStackLayout>

        <CollectionView x:Name="MyTripsList"
                        Grid.Row="2"
                        SelectionMode="None"
                        Footer=" "
                        EmptyView="Todavía no tienes reservas. Explora la pestaña 'Explorar'.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <Border Margin="10,5" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}">
                        <VerticalStackLayout Padding="12" Spacing="4">
                            <Label Text="{Binding Trip.Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding Trip.Destination}" FontSize="14" TextColor="Gray" />
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding Trip.StartDate, StringFormat='{0:dd/MM/yyyy}'}" />
                                <Label Text="al" />
                                <Label Text="{Binding Trip.EndDate, StringFormat='{0:dd/MM/yyyy}'}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding NumberOfSeats}" />
                                <Label Text="asientos ·" />
                                <Label Text="{Binding TotalAmount, StringFormat='{0:C}'}" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Status}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1976D2, Dark=#82B1FF}" />
                            <Button Text="Ver mis pagos"
                                    Clicked="OnPaymentsClicked"
                                    CommandParameter="{Binding .}"
                                    Margin="0,8,0,0" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>