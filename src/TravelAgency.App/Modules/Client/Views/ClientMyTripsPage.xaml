<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientMyTripsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    xmlns:conv="clr-namespace:TravelAgency.App.Converters"
    Title="Mis Viajes">

    <ContentPage.Resources>
        <ResourceDictionary>
            <conv:TripDurationConverter x:Key="TripDuration" />
            <conv:HasValueConverter x:Key="HasValue" />
            <conv:BookingPaymentUrgentConverter x:Key="PaymentUrgent" />
            <conv:BookingExpiringSoonConverter x:Key="ExpiringSoon" />
            <conv:BookingAnticipoConverter x:Key="Anticipo" />
            <conv:BookingNeedsPaymentConverter x:Key="NeedsPayment" />
            <conv:BookingFullyPaidConverter x:Key="FullyPaid" />
            <conv:BookingCancellationNoticeConverter x:Key="CancellationNotice" />
            <conv:BookingCancelledConverter x:Key="Cancelled" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Salir" Clicked="OnLogoutClicked" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0"
                StrokeShape="RoundRectangle 10"
                Stroke="{StaticResource Gray200}"
                BackgroundColor="{StaticResource Gray100}"
                Padding="12,0"
                Margin="12,8,12,4">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                <Label Text="🔍" FontSize="15" VerticalOptions="Center" />
                <Entry x:Name="SearchEntry"
                       Grid.Column="1"
                       Placeholder="Buscar por destino o viaje"
                       BackgroundColor="Transparent"
                       TextColor="{StaticResource Gray950}"
                       PlaceholderColor="{StaticResource Gray500}"
                       FontSize="14"
                       HeightRequest="44"
                       TextChanged="OnSearchTextChanged" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalScrollBarVisibility="Never"
                    Margin="12,4,0,4">
            <HorizontalStackLayout Spacing="8" Padding="0,0,12,0">
                <Button x:Name="PillTodas" Text="Todas"
                        FontSize="13" FontAttributes="Bold" HeightRequest="36" Padding="16,0"
                        CornerRadius="18" MinimumWidthRequest="0"
                        Clicked="OnFilterPillClicked" CommandParameter="all" />
                <Button x:Name="PillPendientes" Text="Pendientes"
                        FontSize="13" FontAttributes="Bold" HeightRequest="36" Padding="16,0"
                        CornerRadius="18" MinimumWidthRequest="0"
                        Clicked="OnFilterPillClicked" CommandParameter="pending" />
                <Button x:Name="PillConfirmadas" Text="Confirmadas"
                        FontSize="13" FontAttributes="Bold" HeightRequest="36" Padding="16,0"
                        CornerRadius="18" MinimumWidthRequest="0"
                        Clicked="OnFilterPillClicked" CommandParameter="confirmed" />
                <Button x:Name="PillCanceladas" Text="Canceladas"
                        FontSize="13" FontAttributes="Bold" HeightRequest="36" Padding="16,0"
                        CornerRadius="18" MinimumWidthRequest="0"
                        Clicked="OnFilterPillClicked" CommandParameter="cancelled" />
            </HorizontalStackLayout>
        </ScrollView>

        <ActivityIndicator x:Name="Loading"
                           Grid.Row="2"
                           IsRunning="False"
                           IsVisible="False"
                           Margin="0,10"
                           VerticalOptions="Start"
                           HorizontalOptions="Center" />

        <RefreshView x:Name="MyTripsRefresh"
                     Grid.Row="2"
                     Refreshing="OnRefreshing">
            <CollectionView x:Name="MyTripsList"
                            SelectionMode="None"
                            Footer=" "
                            EmptyView="Todavía no tienes reservas. Explora la pestaña 'Explorar'.">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Booking">
                    <Border Margin="10,5" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}">
                        <VerticalStackLayout Padding="12" Spacing="4">
                            <Label Text="{Binding Trip.Title}" FontSize="17" FontAttributes="Bold" />
                            <Label Text="{Binding Trip.Destination}" FontSize="14" TextColor="Gray" />
                            <HorizontalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Trip.StartDate, StringFormat='{0:dd/MM/yyyy}'}" />
                                    <Label Text="al" />
                                    <Label Text="{Binding Trip.EndDate, StringFormat='{0:dd/MM/yyyy}'}" />
                                </HorizontalStackLayout>
                                <Border StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#1A512BD4"
                                        Padding="7,1"
                                        VerticalOptions="Center">
                                    <Label Text="{Binding Trip, Converter={StaticResource TripDuration}}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="{StaticResource Tertiary}" />
                                </Border>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="4">
                                <Label Text="{Binding NumberOfSeats}" />
                                <Label Text="asientos ·" />
                                <Label Text="{Binding TotalAmount, StringFormat='{0:C}'}" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                            <Label Text="{Binding Status}" FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#1976D2, Dark=#82B1FF}" />

                            <!-- Aviso: la fecha limite de reserva vence en menos de 24 h -->
                            <Border StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                    BackgroundColor="#14F59E0B" Padding="10"
                                    IsVisible="{Binding ., Converter={StaticResource ExpiringSoon}}">
                                <VerticalStackLayout Spacing="6">
                                    <Border StrokeShape="RoundRectangle 8" BackgroundColor="#F59E0B"
                                            Padding="8,2" HorizontalOptions="Start">
                                        <Label Text="⏳ Expira Pronto" FontSize="11" FontAttributes="Bold" TextColor="White" />
                                    </Border>
                                    <Label Text="{Binding ., Converter={StaticResource PaymentUrgent}}"
                                           IsVisible="{Binding ., Converter={StaticResource HasValue}}"
                                           FontSize="12" TextColor="#8A5200" />
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="{Binding ., Converter={StaticResource Anticipo}}"
                                   FontSize="12" TextColor="Gray" />

                            <Label Text="Pagado 100%" FontSize="12" FontAttributes="Bold"
                                   TextColor="#1B873B"
                                   IsVisible="{Binding ., Converter={StaticResource FullyPaid}}" />

                            <Border StrokeShape="RoundRectangle 10" Stroke="Transparent"
                                    BackgroundColor="#14DC2626" Padding="10"
                                    IsVisible="{Binding ., Converter={StaticResource Cancelled}}">
                                <Label Text="{Binding ., Converter={StaticResource CancellationNotice}}"
                                       FontSize="12" TextColor="#991B1B" />
                            </Border>

                            <Button Text="Ver Detalles"
                                    Clicked="OnPaymentsClicked"
                                    CommandParameter="{Binding .}"
                                    Margin="0,4,0,0" />

                            <Button Text="Ver Comprobante"
                                    BackgroundColor="{StaticResource Tertiary}"
                                    TextColor="White"
                                    FontAttributes="Bold"
                                    CornerRadius="8"
                                    HeightRequest="40"
                                    Margin="0,8,0,0"
                                    IsVisible="{Binding ., Converter={StaticResource Cancelled}}" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>