<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.AddPassengersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Pasajeros adicionales">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="12">

            <Label x:Name="IntroLabel" Text="Registra a las personas que viajarán contigo para generar su código QR individual."
                   FontSize="15" />

            <Label x:Name="FareHintLabel" FontSize="14" FontAttributes="Bold" />

            <VerticalStackLayout x:Name="EntriesLayout" Spacing="14" Margin="0,10,0,20" />

            <Button x:Name="ConfirmButton"
                    Text="Guardar pasajeros"
                    Clicked="OnConfirmClicked"
                    BackgroundColor="#2F855A" TextColor="White" />
            <Button x:Name="BackButton"
                    Text="Volver a mi reserva"
                    Clicked="OnBackClicked"
                    Margin="0,8,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>