<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientCompanyPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Nosotros">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="ColorPrimary">#003B1B</Color>
            <Color x:Key="ColorPrimaryContainer">#14532D</Color>
            <Color x:Key="ColorSecondary">#006C49</Color>
            <Color x:Key="ColorSecondaryFixed">#6CF8BB</Color>
            <Color x:Key="ColorSurface">#FAF8FF</Color>
            <Color x:Key="ColorSurfaceContainerLowest">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceContainerLow">#F2F3FF</Color>
            <Color x:Key="ColorSurfaceContainer">#EAEDFF</Color>
            <Color x:Key="ColorSurfaceContainerHigh">#E2E7FF</Color>
            <Color x:Key="ColorOnSurface">#131B2E</Color>
            <Color x:Key="ColorOnSurfaceVariant">#404941</Color>
            <Color x:Key="ColorOutline">#717970</Color>
            <Color x:Key="ColorError">#BA1A1A</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="{StaticResource ColorSurface}">
        <VerticalStackLayout Padding="20,16,20,28" Spacing="18">

            <!-- ============ MARCA ============ -->
            <Border StrokeShape="RoundRectangle 22" Padding="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="{StaticResource ColorPrimary}" Offset="0" />
                        <GradientStop Color="{StaticResource ColorPrimaryContainer}" Offset="0.55" />
                        <GradientStop Color="{StaticResource ColorSecondary}" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.18" Radius="16" Offset="0,6" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Border WidthRequest="56" HeightRequest="56"
                            StrokeThickness="0"
                            BackgroundColor="#33FFFFFF"
                            StrokeShape="RoundRectangle 18"
                            HorizontalOptions="Start">
                        <Label Text="🌿" FontSize="28"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="RutaVerde"
                           FontSize="26" FontAttributes="Bold"
                           TextColor="White" />
                    <Label Text="Turismo sustentable y seguro"
                           FontSize="14"
                           TextColor="#CCFFFFFF" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ QUIÉNES SOMOS ============ -->
            <Border StrokeShape="RoundRectangle 16"
                    Stroke="{StaticResource ColorSurfaceContainerHigh}"
                    BackgroundColor="{StaticResource ColorSurfaceContainerLowest}"
                    Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label Text="🛡️" FontSize="18" VerticalOptions="Center" />
                        <Label Text="Quiénes somos"
                               FontSize="18" FontAttributes="Bold"
                               TextColor="{StaticResource ColorPrimary}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label Text="Operamos con guías certificados y logística responsable. Tu conformidad garantiza salidas puntuales."
                           FontSize="14"
                           TextColor="{StaticResource ColorOnSurfaceVariant}" />
                    <Label Text="Personalizamos salidas para familias, amigos o empresas desde 10 viajeros."
                           FontSize="14"
                           TextColor="{StaticResource ColorOnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ LO QUE NOS DISTINGUE ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Lo que nos distingue"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource ColorPrimary}" />

                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource ColorSurfaceContainerHigh}"
                        BackgroundColor="{StaticResource ColorSurfaceContainerLowest}"
                        Padding="16">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="12">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="🧭" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Guías certificados" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorOnSurface}" />
                                <Label Text="Acompañamiento experto en cada salida."
                                       FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource ColorSurfaceContainer}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="🌱" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Turismo sustentable" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorOnSurface}" />
                                <Label Text="Viajes responsables con el entorno local."
                                       FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Grid>
                        <BoxView HeightRequest="1" Color="{StaticResource ColorSurfaceContainer}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                            <Border WidthRequest="40" HeightRequest="40"
                                    StrokeThickness="0"
                                    BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                                    StrokeShape="RoundRectangle 12">
                                <Label Text="🚌" FontSize="18"
                                       HorizontalOptions="Center" VerticalOptions="Center" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                <Label Text="Logística responsable" FontSize="14" FontAttributes="Bold"
                                       TextColor="{StaticResource ColorOnSurface}" />
                                <Label Text="Salidas puntuales y transporte seguro."
                                       FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ CONTACTO ============ -->
            <VerticalStackLayout Spacing="8">
                <Label Text="Contacto"
                       FontSize="16" FontAttributes="Bold"
                       TextColor="{StaticResource ColorPrimary}" />

                <Border StrokeShape="RoundRectangle 16"
                        Stroke="{StaticResource ColorSurfaceContainerHigh}"
                        BackgroundColor="{StaticResource ColorSurfaceContainerLowest}"
                        Padding="16,16,16,6">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout Spacing="4">

                        <Border ClassId="Teléfono de contacto" StrokeThickness="0"
                                BackgroundColor="Transparent" Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnComingSoonTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="38" HeightRequest="38"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="📞" FontSize="18"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Teléfono" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="Próximamente" FontSize="11"
                                           TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="20"
                                       TextColor="{StaticResource ColorOutline}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border ClassId="Correo de contacto" StrokeThickness="0"
                                BackgroundColor="Transparent" Padding="8,10">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnComingSoonTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="38" HeightRequest="38"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="✉️" FontSize="18"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="Correo electrónico" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="Próximamente" FontSize="11"
                                           TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="20"
                                       TextColor="{StaticResource ColorOutline}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <Border ClassId="WhatsApp de contacto" StrokeThickness="0"
                                BackgroundColor="Transparent" Padding="8,10,8,14">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnComingSoonTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border WidthRequest="38" HeightRequest="38"
                                        StrokeThickness="0"
                                        BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                                        StrokeShape="RoundRectangle 10">
                                    <Label Text="💬" FontSize="18"
                                           HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                                    <Label Text="WhatsApp" FontSize="15" FontAttributes="Bold"
                                           TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="Próximamente" FontSize="11"
                                           TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="2" Text="›" FontSize="20"
                                       TextColor="{StaticResource ColorOutline}"
                                       VerticalOptions="Center" />
                            </Grid>
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ PIE ============ -->
            <VerticalStackLayout Spacing="2" Margin="0,2,0,0">
                <Label x:Name="VersionLabel"
                       FontSize="11" FontAttributes="Bold"
                       TextColor="{StaticResource ColorOutline}"
                       HorizontalOptions="Center" />
                <Label Text="RutaVerde México"
                       FontSize="11"
                       TextColor="{StaticResource ColorOnSurfaceVariant}"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
