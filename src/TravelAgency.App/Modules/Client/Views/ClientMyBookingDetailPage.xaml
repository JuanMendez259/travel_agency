<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientMyBookingDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    Title="Detalle de Mi Reserva">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="ColorPrimary">#003B1B</Color>
            <Color x:Key="ColorPrimaryContainer">#14532D</Color>
            <Color x:Key="ColorSecondary">#006C49</Color>
            <Color x:Key="ColorSecondaryFixed">#6FFBBE</Color>
            <Color x:Key="ColorSurface">#FAF8FF</Color>
            <Color x:Key="ColorSurfaceContainerLowest">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceContainerLow">#F2F3FF</Color>
            <Color x:Key="ColorSurfaceContainer">#EAEDFF</Color>
            <Color x:Key="ColorSurfaceContainerHigh">#E2E7FF</Color>
            <Color x:Key="ColorOnSurface">#131B2E</Color>
            <Color x:Key="ColorOnSurfaceVariant">#404941</Color>
            <Color x:Key="ColorOutline">#717970</Color>
            <Color x:Key="ColorError">#BA1A1A</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView BackgroundColor="{StaticResource ColorSurface}">
        <VerticalStackLayout Padding="16" Spacing="14">

            <!-- ============ FOTO + TÍTULO ============ -->
            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" Padding="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.08" Radius="14" Offset="0,3" />
                </Border.Shadow>
                <Image x:Name="TripImage" HeightRequest="200" Aspect="AspectFill" />
            </Border>

            <VerticalStackLayout Spacing="2">
                <HorizontalStackLayout Spacing="4">
                    <Label Text="📍" FontSize="12" />
                    <Label x:Name="DestinationLabel" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorSecondary}" />
                </HorizontalStackLayout>
                <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
            </VerticalStackLayout>

            <!-- ============ ACERCA DE ESTE VIAJE ============ -->
            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource ColorSurfaceContainerHigh}" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="🌲" FontSize="15" />
                        <Label Text="Acerca de este viaje" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </HorizontalStackLayout>
                    <Label x:Name="DescriptionLabel" FontSize="13" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ ESTADO DE LA RESERVA (tarjeta verde) ============ -->
            <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" BackgroundColor="{StaticResource ColorPrimary}" Padding="16">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.12" Radius="14" Offset="0,4" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="StatusLabel" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorSecondaryFixed}" />
                    <Label x:Name="BalanceLabel" FontSize="16" FontAttributes="Bold" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ PASE / CÓDIGO QR ============ -->
            <Border x:Name="QrSection"
                    StrokeShape="RoundRectangle 18"
                    Stroke="Transparent"
                    BackgroundColor="{StaticResource ColorPrimaryContainer}"
                    Padding="18"
                    IsVisible="False">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.15" Radius="16" Offset="0,5" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="🎫" FontSize="16" />
                        <Label Text="Mi código QR" FontSize="16" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border StrokeShape="RoundRectangle 14" BackgroundColor="White" Padding="12" HorizontalOptions="Center">
                        <Image x:Name="QrImage" HeightRequest="220" WidthRequest="220" HorizontalOptions="Center" />
                    </Border>

                    <Label Text="Preséntalo en el check-in de tu salida." FontSize="12" TextColor="#4DFFFFFF" HorizontalOptions="Center" HorizontalTextAlignment="Center" />

                    <Label x:Name="PassengersListLabel" FontSize="12" TextColor="#CCFFFFFF" HorizontalOptions="Center" HorizontalTextAlignment="Center" IsVisible="False" />

                    <Button x:Name="AddPassengersButton"
                            Text="Agregar acompañantes"
                            Clicked="OnAddPassengersClicked"
                            IsVisible="False"
                            BackgroundColor="{StaticResource ColorSecondaryFixed}"
                            TextColor="#002113"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46" />

                    <Button x:Name="PassengersQrButton"
                            Text="Ver QR de acompañantes"
                            Clicked="OnPassengersQrClicked"
                            IsVisible="False"
                            BackgroundColor="#33FFFFFF"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46" />
                </VerticalStackLayout>
            </Border>

            <!-- Horarios e Itinerario -->
            <Border StrokeThickness="0" BackgroundColor="#FFFFFF" Padding="14" Margin="0,8,0,0">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Horarios e Itinerario" FontSize="15" FontAttributes="Bold" />
                    <Label x:Name="SalidaLabel" FontSize="14" FontAttributes="Bold" />
                    <Label x:Name="RegresoLabel" FontSize="14" FontAttributes="Bold" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ FECHAS, PRECIO Y TRANSPORTE ============ -->
            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource ColorSurfaceContainerHigh}" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="📅" FontSize="15" />
                        <Label Text="Fechas y Detalles" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </HorizontalStackLayout>

                    <Label x:Name="DatesLabel" FontSize="13" TextColor="{StaticResource ColorOnSurface}" IsVisible="False" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                        <VerticalStackLayout Grid.Column="0">
                            <Label Text="Salida" FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                            <Label x:Name="SalidaLabel" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1">
                            <Label Text="Regreso" FontSize="11" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                            <Label x:Name="RegresoLabel" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Label x:Name="PriceLabel" FontSize="17" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />

                    <BoxView HeightRequest="1" Color="{StaticResource ColorSurfaceContainer}" />

                    <Label x:Name="TransportLabel" FontSize="13" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                    <Label x:Name="AvailabilityLabel" FontSize="13" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ ITINERARIO Y PUNTOS DE INTERÉS ============ -->
            <VerticalStackLayout Spacing="8">
                <Label x:Name="ItineraryHeader" Text="Itinerario y puntos de interés" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" IsVisible="False" />

                <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource ColorSurfaceContainerHigh}" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14"
                        IsVisible="{Binding Source={x:Reference ItineraryHeader}, Path=IsVisible}">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                    </Border.Shadow>
                    <VerticalStackLayout x:Name="ItineraryLayout" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:TripPointOfInterest">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                    <Border StrokeShape="RoundRectangle 14" WidthRequest="26" HeightRequest="26" BackgroundColor="{StaticResource ColorSecondaryFixed}" Padding="0" VerticalOptions="Start">
                                        <Label Text="{Binding Order}" FontSize="11" FontAttributes="Bold" TextColor="#002113" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="1">
                                        <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="13" TextColor="{StaticResource ColorOnSurface}" />
                                        <Label Text="{Binding Description}" FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- ============ RUTA EN MAPA ============ -->
            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource ColorSurfaceContainerHigh}" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="🗺️" FontSize="15" />
                        <Label Text="Ruta y Trayecto" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </HorizontalStackLayout>
                    <Label Text="Consulta el trazado completo de la ruta y los puntos de interés en el mapa interactivo."
                           FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                    <Button x:Name="ForceMapButton"
                            Text="Ver ruta en mapa interactivo"
                            Clicked="OnForceMapClicked"
                            BackgroundColor="{StaticResource ColorPrimary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="48" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ RESERVA Y COSTO ============ -->
            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource ColorSurfaceContainerHigh}" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="💳" FontSize="15" />
                        <Label Text="Reserva y Costo" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </HorizontalStackLayout>
                    <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4" ColumnSpacing="8">
                        <Label Grid.Row="0" Grid.Column="0" Text="Cupo reservado" FontSize="13" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                        <Label Grid.Row="0" Grid.Column="1" x:Name="ReservaCupoLabel" FontSize="13" TextColor="{StaticResource ColorOnSurface}" />
                        <Label Grid.Row="1" Grid.Column="0" Text="Conceptos incluidos" FontSize="13" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                        <Label Grid.Row="1" Grid.Column="1" x:Name="ReservaIncluyeLabel1" FontSize="13" TextColor="{StaticResource ColorSecondary}" />
                        <Label Grid.Row="2" Grid.Column="0" x:Name="ReservaIncluyeLabel2" IsVisible="False" FontSize="13" TextColor="{StaticResource ColorSecondary}" />
                        <Label Grid.Row="2" Grid.Column="1" Text="Total" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </Grid>
                    <Label x:Name="ReservaTotalLabel" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" HorizontalOptions="End" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ HISTORIAL DE PAGO ============ -->
            <Border StrokeShape="RoundRectangle 16" Stroke="{StaticResource ColorSurfaceContainerHigh}" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="💰" FontSize="15" />
                        <Label Text="Historial de Pago" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </HorizontalStackLayout>
                    <VerticalStackLayout Spacing="4">
                        <Label x:Name="PagoAbono1Label" FontSize="13" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                        <Label x:Name="PagoAbono2Label" FontSize="13" TextColor="{StaticResource ColorOnSurfaceVariant}" IsVisible="False" />
                        <Label x:Name="PagoSaldoLabel" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </VerticalStackLayout>
                    <Button x:Name="DownloadReceiptButton" Text="Descargar Recibo Digital (PDF)" IsVisible="False" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ MIS PAGOS ============ -->
            <VerticalStackLayout Spacing="8">
                <HorizontalStackLayout Spacing="6">
                    <Label Text="💳" FontSize="15" />
                    <Label Text="Mis pagos" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                </HorizontalStackLayout>

                <CollectionView x:Name="PaymentsList"
                                SelectionMode="None"
                                EmptyView="Aún no has realizado pagos para esta reserva.">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Payment">
                            <Border Margin="0,4" StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurfaceContainerLow}" Padding="12">
                                <VerticalStackLayout Spacing="3">
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding PaymentDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}" FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                        <Label Text="·" FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                        <Label Text="{Binding Method}" FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                    </HorizontalStackLayout>
                                    <HorizontalStackLayout Spacing="4">
                                        <Label Text="{Binding Amount, StringFormat='{0:C}'}" FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                                        <Label Text="·" FontSize="14" TextColor="{StaticResource ColorOnSurface}" />
                                        <Label Text="{Binding Status}" FontSize="13" TextColor="{StaticResource ColorSecondary}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label x:Name="PaymentsTotalLabel" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" IsVisible="False" />
            </VerticalStackLayout>

            <!-- ============ CANCELACIÓN ============ -->
            <Border x:Name="CancelSection"
                    StrokeShape="RoundRectangle 16"
                    Stroke="Transparent"
                    BackgroundColor="#FFDAD6"
                    Padding="14"
                    IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="⚠️" FontSize="14" />
                        <Label Text="Cancelación de la reserva" FontSize="15" FontAttributes="Bold" TextColor="#93000A" />
                    </HorizontalStackLayout>
                    <Label x:Name="CancelPolicyLabel" FontSize="12" TextColor="#5C0004" />
                    <Label x:Name="CancelRefundLabel" FontSize="12" FontAttributes="Bold" TextColor="#5C0004" />
                    <Button x:Name="CancelButton"
                            Text="Cancelar reserva"
                            Clicked="OnCancelClicked"
                            BackgroundColor="{StaticResource ColorError}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="46" />
                </VerticalStackLayout>
            </Border>

            <!-- ============ CALIFICAR VIAJE ============ -->
            <VerticalStackLayout Spacing="6">
                <Label x:Name="RateHintLabel" FontSize="13" TextColor="{StaticResource ColorOnSurfaceVariant}" IsVisible="False" />
                <Button x:Name="RateButton" Text="Calificar viaje"
                        Clicked="OnRateClicked"
                        IsVisible="False"
                        BackgroundColor="{StaticResource ColorSecondary}"
                        TextColor="White"
                        FontAttributes="Bold"
                        CornerRadius="12"
                        HeightRequest="48" />
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
