<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientMyBookingDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:TravelAgency.Shared.Models;assembly=TravelAgency.Shared"
    Title="Detalle de Mi Reserva">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">

            <Image x:Name="TripImage" HeightRequest="200" Aspect="AspectFill" />
            <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="DestinationLabel" FontSize="16" TextColor="Gray" />
            <Label x:Name="DatesLabel" FontSize="15" />
            <Label x:Name="PriceLabel" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="TransportLabel" FontSize="14" />
            <Label x:Name="AvailabilityLabel" FontSize="14" TextColor="Gray" />
            <Label x:Name="StatusLabel" FontSize="15" FontAttributes="Bold" Margin="0,6,0,0" />
            <Label x:Name="BalanceLabel" FontSize="15" FontAttributes="Bold" TextColor="#1976D2" />

            <Border x:Name="QrSection"
                    StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#2C2C2C}"
                    Padding="16"
                    Margin="0,10,0,0"
                    IsVisible="False">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Mi código QR" FontSize="16" FontAttributes="Bold" HorizontalOptions="Center" />
                    <Image x:Name="QrImage" HeightRequest="240" WidthRequest="240" HorizontalOptions="Center" />
                    <Label Text="Preséntalo en el check-in de tu salida." FontSize="13" TextColor="Gray" HorizontalOptions="Center" />
                    <Label x:Name="PassengersListLabel" FontSize="13" TextColor="Gray" HorizontalOptions="Center" IsVisible="False" />
                    <Button x:Name="AddPassengersButton"
                            Text="Agregar acompañantes"
                            Clicked="OnAddPassengersClicked"
                            IsVisible="False"
                            BackgroundColor="#2F855A" TextColor="White" />
                    <Button x:Name="PassengersQrButton"
                            Text="Ver QR de acompañantes"
                            Clicked="OnPassengersQrClicked"
                            IsVisible="False"
                            BackgroundColor="#1976D2" TextColor="White" />
                </VerticalStackLayout>
            </Border>

            <Label Text="Descripción" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label x:Name="DescriptionLabel" FontSize="14" />

            <Label x:Name="MapHeader" Text="Mapa y recorrido" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" IsVisible="False" />
            <WebView x:Name="TripMapView" HeightRequest="260" IsVisible="False" />

            <Label x:Name="ItineraryHeader" Text="Itinerario y puntos de interés" FontSize="16" FontAttributes="Bold" Margin="0,10,0,0" IsVisible="False" />
            <VerticalStackLayout x:Name="ItineraryLayout" Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:TripPointOfInterest">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Label Text="{Binding Order, StringFormat='{0}.'}" FontAttributes="Bold" TextColor="#1976D2" />
                            <VerticalStackLayout Grid.Column="1" Spacing="1">
                                <Label Text="{Binding Name}" FontAttributes="Bold" FontSize="14" />
                                <Label Text="{Binding Description}" FontSize="13" TextColor="Gray" />
                            </VerticalStackLayout>
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <Label Text="Mis pagos" FontSize="18" FontAttributes="Bold" Margin="0,15,0,0" />
            <CollectionView x:Name="PaymentsList"
                            SelectionMode="None"
                            Footer=" "
                            EmptyView="Aún no has realizado pagos para esta reserva.">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Payment">
                        <Border Margin="0,4" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EEEEEE, Dark=#2C2C2C}">
                            <VerticalStackLayout Padding="12" Spacing="2">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding PaymentDate, StringFormat='{0:dd/MM/yyyy HH:mm}'}" TextColor="Gray" />
                                    <Label Text="·" TextColor="Gray" />
                                    <Label Text="{Binding Method}" TextColor="Gray" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="{Binding Amount, StringFormat='{0:C}'}" FontAttributes="Bold" />
                                    <Label Text="·" />
                                    <Label Text="{Binding Status}" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label x:Name="PaymentsTotalLabel" FontSize="13" TextColor="Gray" IsVisible="False" />

            <Label x:Name="RateHintLabel" FontSize="14" TextColor="Gray" Margin="0,10,0,0" IsVisible="False" />
            <Button x:Name="RateButton" Text="Calificar viaje"
                    Clicked="OnRateClicked"
                    IsVisible="False"
                    Margin="0,6,0,0"
                    BackgroundColor="#2F855A" TextColor="White" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>