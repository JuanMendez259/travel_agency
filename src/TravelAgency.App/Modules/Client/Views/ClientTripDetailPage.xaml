<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientTripDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle del Viaje">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="DestinationLabel" FontSize="16" TextColor="Gray" />
            <Label x:Name="DatesLabel" FontSize="15" />
            <Label x:Name="PriceLabel" FontSize="18" FontAttributes="Bold" />
            <Label x:Name="DescriptionLabel" FontSize="14" />
            <Label x:Name="SeatsLabel" FontSize="14" TextColor="Gray" />

            <Border Margin="0,20,0,0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F4F4F4, Dark=#2C2C2C}">
                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="Reservar viaje" FontSize="16" FontAttributes="Bold" />
                    <Label Text="Número de asientos" FontSize="14" />
                    <Entry x:Name="SeatsEntry" Keyboard="Numeric" Text="1" />
                    <Button x:Name="BookButton" Text="Confirmar reserva" Clicked="OnBookClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>