<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientTripDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Detalle del Viaje">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Image x:Name="TripImage" HeightRequest="200" Aspect="AspectFill" />
            <Label x:Name="TitleLabel" FontSize="22" FontAttributes="Bold" />
            <Label x:Name="DestinationLabel" FontSize="16" TextColor="Gray" />
            <Label x:Name="DatesLabel" FontSize="15" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label x:Name="PriceLabel" FontSize="18" FontAttributes="Bold" VerticalOptions="Center" />
                <Button x:Name="FavoriteButton"
                        Grid.Column="1"
                        Text="♡"
                        TextColor="Gray"
                        FontSize="28"
                        Padding="8"
                        BackgroundColor="Transparent"
                        Clicked="OnFavoriteClicked"
                        VerticalOptions="Center" />
            </Grid>
            <Label x:Name="ChildPriceLabel" FontSize="14" TextColor="Gray" IsVisible="False" />
            <Label x:Name="DescriptionLabel" FontSize="14" />
            <Label x:Name="TransportLabel" FontSize="14" />
            <Label x:Name="SeatsLabel" FontSize="14" TextColor="Gray" />

            <Border x:Name="BookPanel" Margin="0,20,0,0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F4F4F4, Dark=#2C2C2C}">
                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="Reservar viaje" FontSize="16" FontAttributes="Bold" />
                    <Label Text="Número de asientos" FontSize="14" />
                    <Entry x:Name="SeatsEntry" Keyboard="Numeric" Text="1" />
                    <Label x:Name="MultiSeatHint" Text="Con más de un asiento registrarás el nombre y la edad de cada acompañante." FontSize="13" TextColor="Gray" />
                    <Button x:Name="BookButton" Text="Confirmar reserva" Clicked="OnBookClicked" />
                </VerticalStackLayout>
            </Border>

            <Border x:Name="NoCapacityPanel" IsVisible="False" Margin="0,20,0,0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#F4F4F4, Dark=#2C2C2C}">
                <VerticalStackLayout Padding="16" Spacing="8">
                    <Label Text="Sin cupo disponible" FontSize="16" FontAttributes="Bold" />
                    <Label Text="Puedes pedirle al administrador que amplíe la capacidad de este viaje." FontSize="14" />
                    <Label Text="¿Cuántos asientos necesitas?" FontSize="14" />
                    <Entry x:Name="RequestedSeatsEntry" Keyboard="Numeric" Text="1" />
                    <Label Text="Mensaje (opcional)" FontSize="14" />
                    <Editor x:Name="RequestMessageEditor" HeightRequest="80" />
                    <Button x:Name="RequestCapacityButton" Text="Solicitar más cupo" Clicked="OnRequestCapacityClicked" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>