<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientImageViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TravelAgency.App.Controls"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False"
    Shell.TabBarIsVisible="False">

    <Grid IsClippedToBounds="True">

        <!-- Superficie de gestos: recibe pinch, pan y doble toque -->
        <Grid x:Name="GestureSurface" BackgroundColor="Black">
            <Grid.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
            </Grid.GestureRecognizers>

            <controls:NetworkImage
                x:Name="ZoomImage"
                Aspect="AspectFit"
                BackgroundColor="Black"
                HorizontalOptions="Fill"
                InputTransparent="True"
                VerticalOptions="Fill" />
        </Grid>

        <!-- Cerrar: único control interactivo sobre la foto -->
        <Button
            Text="✕"
            WidthRequest="44"
            HeightRequest="44"
            MinimumWidthRequest="44"
            MinimumHeightRequest="44"
            Margin="12,10,0,0"
            Padding="0"
            BackgroundColor="#66000000"
            BorderWidth="0"
            CornerRadius="22"
            FontSize="18"
            HorizontalOptions="Start"
            TextColor="#FFFFFF"
            VerticalOptions="Start"
            Clicked="OnCloseClicked"
            SemanticProperties.Description="Cerrar visor de foto" />

        <!-- Título y ayuda no deben bloquear los gestos -->
        <Label
            x:Name="TitleLabel"
            Margin="64,24,64,0"
            FontAttributes="Bold"
            FontSize="15"
            HorizontalOptions="Center"
            HorizontalTextAlignment="Center"
            InputTransparent="True"
            LineBreakMode="TailTruncation"
            TextColor="#FFFFFF"
            VerticalOptions="Start" />

        <Border
            Margin="20,0,20,28"
            Padding="14,8"
            BackgroundColor="#99000000"
            HorizontalOptions="Center"
            InputTransparent="True"
            StrokeShape="RoundRectangle 100"
            StrokeThickness="0"
            VerticalOptions="End">
            <Label
                FontSize="12"
                HorizontalTextAlignment="Center"
                Text="Pellizca para hacer zoom · doble toque para acercar"
                TextColor="#FFFFFF" />
        </Border>
    </Grid>
</ContentPage>
