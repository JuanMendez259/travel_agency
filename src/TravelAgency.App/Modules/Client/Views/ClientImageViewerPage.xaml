<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.ClientImageViewerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:controls="clr-namespace:TravelAgency.App.Controls"
    BackgroundColor="Black"
    Shell.NavBarIsVisible="False">

    <Grid IsClippedToBounds="True" RowDefinitions="Auto,*">

        <!-- La foto ocupa toda la pantalla detras de los controles -->
        <controls:NetworkImage
            x:Name="ZoomImage"
            Grid.RowSpan="2"
            Aspect="AspectFit"
            BackgroundColor="Black"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <controls:NetworkImage.GestureRecognizers>
                <PinchGestureRecognizer PinchUpdated="OnPinchUpdated" />
                <PanGestureRecognizer PanUpdated="OnPanUpdated" />
                <TapGestureRecognizer NumberOfTapsRequired="2" Tapped="OnDoubleTapped" />
            </controls:NetworkImage.GestureRecognizers>
        </controls:NetworkImage>

        <!-- Barra superior: cerrar a la izquierda, titulo al centro -->
        <Grid
            Grid.Row="0"
            Padding="12,10,12,0"
            ColumnDefinitions="44,*,44"
            ColumnSpacing="8">
            <Button
                Text="✕"
                WidthRequest="44"
                HeightRequest="44"
                MinimumWidthRequest="44"
                MinimumHeightRequest="44"
                Padding="0"
                BackgroundColor="#66000000"
                BorderWidth="0"
                CornerRadius="22"
                FontSize="18"
                TextColor="#FFFFFF"
                Clicked="OnCloseClicked"
                SemanticProperties.Description="Cerrar visor de foto" />
            <Label
                x:Name="TitleLabel"
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="15"
                HorizontalTextAlignment="Center"
                LineBreakMode="TailTruncation"
                TextColor="#FFFFFF"
                VerticalOptions="Center" />
        </Grid>

        <!-- Ayuda de gestos -->
        <Border
            Grid.Row="1"
            Margin="20,0,20,28"
            Padding="14,8"
            BackgroundColor="#99000000"
            HorizontalOptions="Center"
            StrokeShape="RoundRectangle 100"
            StrokeThickness="0"
            VerticalOptions="End">
            <Label
                FontSize="12"
                HorizontalTextAlignment="Center"
                Text="Pellizca para hacer zoom · doble toque para acercar"
                TextColor="#FFFFFF" />
        </Border>
    </Grid>
</ContentPage>
