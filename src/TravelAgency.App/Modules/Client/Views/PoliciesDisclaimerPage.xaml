<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Client.Views.PoliciesDisclaimerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="ColorPrimary">#003B1B</Color>
            <Color x:Key="ColorPrimaryContainer">#14532D</Color>
            <Color x:Key="ColorSecondary">#006C49</Color>
            <Color x:Key="ColorSecondaryFixed">#6FFBBE</Color>
            <Color x:Key="ColorSurface">#FAF8FF</Color>
            <Color x:Key="ColorSurfaceContainerLowest">#FFFFFF</Color>
            <Color x:Key="ColorSurfaceContainerLow">#F2F3FF</Color>
            <Color x:Key="ColorSurfaceContainer">#EAEDFF</Color>
            <Color x:Key="ColorOnSurface">#131B2E</Color>
            <Color x:Key="ColorOnSurfaceVariant">#404941</Color>
            <Color x:Key="ColorOutline">#717970</Color>
            <Color x:Key="ColorError">#BA1A1A</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" BackgroundColor="{StaticResource ColorSurface}">

        <!-- ============ ENCABEZADO ============ -->
        <Grid Grid.Row="0" Padding="20,16,12,12" ColumnDefinitions="*,Auto">
            <VerticalStackLayout Grid.Column="0" Spacing="4">
                <HorizontalStackLayout Spacing="6">
                    <Border StrokeShape="RoundRectangle 20" WidthRequest="20" HeightRequest="20" BackgroundColor="{StaticResource ColorPrimaryContainer}" Padding="0">
                        <Label Text="✓" FontSize="11" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="ACEPTACIÓN EN DOS PASOS" FontSize="10" FontAttributes="Bold" TextColor="{StaticResource ColorSecondary}" VerticalOptions="Center" />
                </HorizontalStackLayout>
                <Label Text="Políticas y Condiciones" FontSize="20" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
            </VerticalStackLayout>
            <Button Grid.Column="1"
                    Text="✕"
                    Clicked="OnCloseClicked"
                    FontSize="16"
                    WidthRequest="38"
                    HeightRequest="38"
                    Padding="0"
                    CornerRadius="19"
                    BackgroundColor="{StaticResource ColorSurfaceContainerLow}"
                    TextColor="{StaticResource ColorOnSurfaceVariant}"
                    VerticalOptions="Start" />
        </Grid>

        <!-- ============ CONTENIDO ============ -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,4,20,24" Spacing="16">

                <!-- Tarjeta de aviso destacado -->
                <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14">
                    <Border.Shadow>
                        <Shadow Brush="Black" Opacity="0.06" Radius="14" Offset="0,3" />
                    </Border.Shadow>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <Border StrokeShape="RoundRectangle 20" WidthRequest="38" HeightRequest="38" BackgroundColor="#4D6FFBBE" Padding="0" VerticalOptions="Start">
                            <Label Text="🛡️" FontSize="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="3">
                            <Label Text="Antes de confirmar tu reserva te pedimos leer y aceptar las siguientes políticas."
                                   FontSize="14" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                            <Label Text="Operamos con guías certificados y logística responsable. Tu conformidad garantiza salidas puntuales."
                                   FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Políticas de reservación -->
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="📅" FontSize="14" />
                        <Label Text="Políticas de Reservación" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </HorizontalStackLayout>

                    <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource ColorSurfaceContainer}" Padding="0">
                                    <Label Text="⏳" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Confirmación de la agencia" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="Tu reserva queda pendiente hasta que la agencia la confirme; la confirmación la realiza el administrador."
                                           FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource ColorSurfaceContainer}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource ColorSurfaceContainer}" Padding="0">
                                    <Label Text="💲" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Precio y tarifa de menores" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="El precio mostrado es el vigente al momento de reservar. Los niños de 0 a 11 años pagan tarifa de niño cuando está disponible; si no, pagan tarifa completa."
                                           FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource ColorSurfaceContainer}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource ColorSurfaceContainer}" Padding="0">
                                    <Label Text="📱" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Código QR por pasajero" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="Cada pasajero recibirá un código QR individual que deberá presentar el día del viaje para el check-in."
                                           FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource ColorSurfaceContainer}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource ColorSurfaceContainer}" Padding="0">
                                    <Label Text="💺" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Disponibilidad de asientos" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="La reserva está sujeta a la disponibilidad de asientos del viaje."
                                           FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Políticas de cancelación -->
                <VerticalStackLayout Spacing="8">
                    <HorizontalStackLayout Spacing="6">
                        <Label Text="↩️" FontSize="14" />
                        <Label Text="Políticas de Cancelación y Reembolsos" FontSize="15" FontAttributes="Bold" TextColor="{StaticResource ColorPrimary}" />
                    </HorizontalStackLayout>

                    <Border StrokeShape="RoundRectangle 16" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurfaceContainerLowest}" Padding="14">
                        <Border.Shadow>
                            <Shadow Brush="Black" Opacity="0.05" Radius="12" Offset="0,2" />
                        </Border.Shadow>
                        <VerticalStackLayout Spacing="10">

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource ColorSurfaceContainer}" Padding="0">
                                    <Label Text="📞" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Cómo cancelar" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="Las cancelaciones son gestionadas por la agencia o el administrador; puedes solicitarla contactando a la agencia y se procesará en la medida en que lo permita el viaje."
                                           FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource ColorSurfaceContainer}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32" BackgroundColor="{StaticResource ColorSurfaceContainer}" Padding="0">
                                    <Label Text="🔓" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Liberación de asientos" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="La cancelación libera los asientos reservados para que otros clientes puedan reservarlos."
                                           FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>
                            <BoxView HeightRequest="1" Color="{StaticResource ColorSurfaceContainer}" />

                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                                <Border StrokeShape="RoundRectangle 9" WidthRequest="32" HeightRequest="32" BackgroundColor="#FFDAD6" Padding="0">
                                    <Label Text="🚫" FontSize="14" HorizontalOptions="Center" VerticalOptions="Center" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1" Spacing="1">
                                    <Label Text="Después de la salida o check-in" FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />
                                    <Label Text="Una vez realizada la salida o concluido el check-in, la reserva no podrá cancelarse."
                                           FontSize="12" TextColor="{StaticResource ColorOnSurfaceVariant}" />
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ============ PANEL DE DOBLE VALIDACIÓN ============ -->
        <Border Grid.Row="2" Margin="16,0,16,16"
                StrokeShape="RoundRectangle 18"
                Stroke="Transparent"
                BackgroundColor="{StaticResource ColorSurfaceContainerLowest}"
                Padding="16">
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.1" Radius="18" Offset="0,-2" />
            </Border.Shadow>
            <VerticalStackLayout Spacing="12">

                <!-- Paso 1: checkbox -->
                <Border StrokeShape="RoundRectangle 14" Stroke="Transparent" BackgroundColor="{StaticResource ColorSurfaceContainerLow}" Padding="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <CheckBox x:Name="PoliciesCheck"
                                  Color="{StaticResource ColorPrimary}"
                                  VerticalOptions="Start"
                                  CheckedChanged="OnPoliciesCheckedChanged" />
                        <Label Grid.Column="1"
                               Text="He leído y acepto íntegramente las políticas de reservación y las políticas de cancelación de RutaVerde."
                               FontSize="13" TextColor="{StaticResource ColorOnSurface}" VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Paso 2: swipe -->
                <VerticalStackLayout x:Name="StepTwoPanel" Spacing="8" IsVisible="False">
                    <Label Text="Última confirmación: desliza hasta el final para aceptar las condiciones."
                           FontSize="13" FontAttributes="Bold" TextColor="{StaticResource ColorOnSurface}" />

                    <Grid x:Name="SwipeTrack"
                          HeightRequest="58"
                          BackgroundColor="Transparent"
                          InputTransparent="False"
                          SemanticProperties.Description="Desliza para aceptar las condiciones">
                        <Grid.GestureRecognizers>
                            <PanGestureRecognizer PanUpdated="OnSwipePanUpdated" />
                        </Grid.GestureRecognizers>

                        <Border StrokeShape="RoundRectangle 29"
                                Stroke="Transparent"
                                BackgroundColor="{StaticResource ColorSurfaceContainer}"
                                Padding="0" />

                        <Border x:Name="SwipeFill"
                                StrokeShape="RoundRectangle 29"
                                BackgroundColor="#4D6FFBBE"
                                HorizontalOptions="Start"
                                WidthRequest="0" />

                        <Label x:Name="SwipeLabel"
                               Text="Acepto las condiciones"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="{StaticResource ColorOnSurfaceVariant}"
                               InputTransparent="True" />

                        <Border x:Name="SwipeThumb"
                                WidthRequest="48"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                BackgroundColor="{StaticResource ColorPrimary}"
                                HorizontalOptions="Start"
                                VerticalOptions="Center"
                                Margin="4,0,0,0"
                                InputTransparent="True">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.25" Radius="6" Offset="0,2" />
                            </Border.Shadow>
                            <Label Text="→" FontSize="20" FontAttributes="Bold" TextColor="White"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <Button x:Name="FinalConfirmButton"
                            Text="Confirmar y reservar"
                            BackgroundColor="{StaticResource ColorPrimary}"
                            TextColor="White"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50"
                            IsEnabled="False"
                            Clicked="OnFinalConfirmClicked" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
