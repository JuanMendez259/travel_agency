<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage
    x:Class="TravelAgency.App.Modules.Auth.Views.LoginPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="TravelAgency">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="12" VerticalOptions="Center">

            <Image Source="logo.jpg"
                   HeightRequest="180"
                   Aspect="AspectFit"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <Label Text="TravelAgency"
                   FontSize="34"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />
            <Label Text="Tu agencia de viajes"
                   FontSize="15"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20" />

            <Label x:Name="FormTitleLabel" Text="Iniciar sesión" FontSize="20" FontAttributes="Bold" />

            <Entry x:Name="NameEntry"
                   Placeholder="Nombre"
                   IsVisible="False" />

            <Entry x:Name="PhoneEntry"
                   Placeholder="Celular (opcional)"
                   Keyboard="Telephone"
                   IsVisible="False" />

            <Entry x:Name="EmailEntry"
                   Placeholder="Correo electrónico"
                   Keyboard="Email" />

            <Entry x:Name="PasswordEntry"
                   Placeholder="Contraseña"
                   IsPassword="True" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" Margin="0,4,0,0">
                <CheckBox x:Name="RememberCheckBox" VerticalOptions="Center" />
                <Label Grid.Column="1"
                       Text="Recordar contraseña"
                       FontSize="14"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRememberTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </Grid>

            <Button x:Name="SubmitButton" Text="Entrar" Clicked="OnSubmitClicked" />
            <Button x:Name="ToggleButton"
                    Text="¿No tienes cuenta? Crea una"
                    BackgroundColor="Transparent"
                    TextColor="{AppThemeBinding Light=#1976D2, Dark=#82B1FF}"
                    Clicked="OnToggleClicked" />

            <Label Text="Acceso rápido (solo pruebas)"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#757575, Dark=#9E9E9E}"
                   Margin="0,20,0,0" />
            <Picker x:Name="QuickLoginPicker"
                    Title="Seleccionar perfil de prueba"
                    SelectedIndexChanged="OnQuickLoginSelected" />

            <BoxView HeightRequest="1"
                     Color="{AppThemeBinding Light=#E2E8F0, Dark=#374151}"
                     Margin="0,24,0,14" />

            <Label Text="Síguenos en redes sociales"
                   FontSize="13"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   Margin="0,0,0,10" />

            <HorizontalStackLayout Spacing="24"
                                   HorizontalOptions="Center">
                <ImageButton x:Name="FacebookButton"
                             Source="https://onddztbqjmmybojkspjl.supabase.co/storage/v1/object/public/company_image/fb.png"
                             WidthRequest="44"
                             HeightRequest="44"
                             Aspect="AspectFit"
                             BackgroundColor="Transparent"
                             Clicked="OnFacebookClicked" />
                <ImageButton x:Name="InstagramButton"
                             Source="https://onddztbqjmmybojkspjl.supabase.co/storage/v1/object/public/company_image/insta.png"
                             WidthRequest="44"
                             HeightRequest="44"
                             Aspect="AspectFit"
                             BackgroundColor="Transparent"
                             Clicked="OnInstagramClicked" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>